{
  "name": "dystate-log-studio",
  "description": "A private Markdown and MDX log editor for Dystate.",
  "author": "Dystate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync ios",
    "mobile:icon": "node scripts/generate-ios-icon.mjs",
    "mobile:open": "cap open ios",
    "build:desktop-web": "astro check && astro build --config astro.desktop.config.mjs",
    "desktop:pack": "npm run build:desktop-web && electron-builder --win portable",
    "desktop:dir": "npm run build:desktop-web && electron-builder --win dir",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@astrojs/react": "^5.0.7",
    "@astrojs/vercel": "^10.0.8",
    "@codemirror/lang-markdown": "^6.5.2",
    "@supabase/supabase-js": "^2.112.3",
    "@uiw/react-codemirror": "^4.25.11",
    "astro": "^6.4.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^10.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
    ,"sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.dystate.logstudio",
    "productName": "Dystate Log Studio",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop",
        "to": "app-server"
      }
    ],
    "win": {
      "target": ["portable"],
      "icon": "../public/favicon.ico",
      "artifactName": "Dystate-Log-Studio-${version}.exe"
    }
  }
}
