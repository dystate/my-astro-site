# Browser-safe Supabase settings
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
PUBLIC_SUPABASE_BUCKET=log-assets
# iOS 静态壳调用的线上 Log Studio 地址，例如 https://logs.example.com
PUBLIC_API_BASE_URL=

# Server-side auth validation (may reuse the public URL/key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
LOG_STUDIO_ALLOWED_EMAILS=you@example.com
LOG_STUDIO_ALLOWED_ORIGINS=capacitor://localhost,http://localhost

# Production content provider: github
LOG_CONTENT_PROVIDER=github
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO_OWNER=dystate
GITHUB_REPO_NAME=my-astro-site
GITHUB_BRANCH=main
GITHUB_LOGS_BASE=src/data/logs

# Local development only. Never enable these in production.
PUBLIC_DEV_BYPASS_AUTH=false
DEV_BYPASS_AUTH=false
# LOGS_LOCAL_ROOT=E:/Astro/src/data/logs
