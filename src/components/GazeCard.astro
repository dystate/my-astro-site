---
// GazeCard.astro
// 图层:网格底 + 画作 + 悬停显影层(已移除迷宫纹和测量标记)
// 悬停层:① 传入 hoverImage(PNG)→ 显示该图;② 不传 → 用内置文字海报层
// 点击整张卡片跳转 href

export interface Props {
  href: string;
  image: string;
  imageAlt?: string;
  hoverImage?: string;
  cornerImage?: string;   // 四角文字图(建议透明 PNG)
  hoverAlt?: string;
  eyebrow?: string;
  titleJa?: string;
  subtitle?: string;
  coords?: string;
  index?: number;
  newTab?: boolean;
}

const {
  href,
  image,
  imageAlt = "",
  hoverImage,
  cornerImage,
  hoverAlt = "",
  eyebrow = "Three Gazes",
  titleJa = "三位の視線",
  subtitle = "想像力の飛翔",
  coords = "36.2048° N / 138.2529° E",
  index = 1,
  newTab = false,
} = Astro.props;

const target = newTab ? "_blank" : undefined;
const rel = newTab ? "noopener noreferrer" : undefined;
const hasHoverImg = Boolean(hoverImage);
const hasCorner = Boolean(cornerImage);
---

<a
  class:list={["gaze-card", { "has-hover-img": hasHoverImg }]}
  href={href}
  target={target}
  rel={rel}
  data-index={index}
  aria-label={`${eyebrow} — ${titleJa}`}
>
  <!-- 2. 画作图层(默认略斜,悬停归位) -->
  <div class="layer layer--art">
    <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </div>

  <!-- 3a. 悬停显影:你自己画的 PNG(传了 hoverImage 才渲染) -->
  {hasHoverImg && (
    <div class="layer layer--hover-img">
      <img src={hoverImage} alt={hoverAlt} loading="lazy" decoding="async" />
    </div>
  )}

  <!-- 3b. 悬停显影:内置文字海报层(没传 hoverImage 时用) -->
  {!hasHoverImg && (
    <div class="layer layer--poster">
      <span class="poster-eyebrow">{eyebrow}</span>
      <h3 class="poster-title">{titleJa}</h3>
      <p class="poster-sub" lang="ja">{subtitle}</p>
      <slot />
      <img class="poster-arrow" src="/images/arrow.png" alt="" aria-hidden="true" />
    </div>
  )}
  <!-- 4. 四角文字层(始终在最上) -->
  {hasCorner && (
    <div class="layer layer--corners" aria-hidden="true">
      <img class="corner corner--tr" src={cornerImage} alt="" />
    </div>
  )}
</a>

<style>
  .gaze-card {
    --ink: #1a1208;
    --paper: #fff7ec;
    --line: rgba(255, 138, 0, 0.30);
    --line-strong: rgba(255, 120, 0, 0.55);
    --bg: rgba(255, 255, 255, 0.5);

    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: transparent;
    color: var(--paper);
    overflow: visible;
    text-decoration: none;
    isolation: isolate;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .layer { position: absolute; inset: 0; }


  .layer--art {
    inset: 7% 8%;
    transform: rotate(-1.6deg) scale(0.98);
    transform-origin: center;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.5s ease;
    overflow: hidden;
  }
  .layer--art img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* 3a. 悬停 PNG 层 */
  .layer--hover-img { opacity: 0; transition: opacity 0.45s ease; pointer-events: none; }
  .layer--hover-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* 3b. 文字海报层 */
  .layer--poster {
    display: flex; flex-direction: column; padding: 14% 9% 9%;
    color: var(--paper); opacity: 0; transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  .poster-eyebrow {
    font: 600 11px/1 "Helvetica Neue", Arial, sans-serif; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink); background: var(--paper);
    padding: 3px 7px; align-self: flex-start;
  }
  .poster-title {
    margin: 0.35em 0 0; font: 800 clamp(30px, 7vw, 56px)/0.92 "Noto Serif JP", "Yu Mincho", serif;
    letter-spacing: 0.02em; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }
  .poster-sub {
    margin: 0.5em 0 0; font: 500 12px/1.5 "Noto Sans JP", system-ui, sans-serif;
    max-width: 9em; background: rgba(14, 11, 8, 0.55); padding: 4px 8px; align-self: flex-start;
  }
  /* 绿框位置的 arrow 图(在海报层内,悬停时随文字一起出现) */
  .poster-arrow {
    position: absolute;
    bottom: 8%;
    right: 18%;
    width: 35%;          /* 大小,自己调 */
    height: auto;
    /* 若 arrow.jpg 是白底,把下一行注释掉换成: mix-blend-mode: multiply; */
    opacity: 1;
  }


  /* 四角文字层 */
  .layer--corners { pointer-events: none; }
  .corner {
    position: absolute;
    width: var(--corner-size, 120%);
    height: auto;
    opacity: 0.95;
    /* 白底图改用: mix-blend-mode: multiply; */
  }
  .corner--tr { top: -9%; right: -9%; }

  .gaze-card:hover, .gaze-card:focus-visible { transform: translateY(-4px); outline: none; }
  .gaze-card:hover .layer--art, .gaze-card:focus-visible .layer--art { transform: rotate(0deg) scale(1); filter: brightness(0.62) saturate(0.85); }
  .gaze-card:hover .layer--poster, .gaze-card:focus-visible .layer--poster { opacity: 1; transform: translateY(0); }
  .gaze-card:hover .layer--hover-img, .gaze-card:focus-visible .layer--hover-img { opacity: 1; }
  .gaze-card:focus-visible { box-shadow: 0 0 0 2px var(--paper); }

  @media (prefers-reduced-motion: reduce) {
    .gaze-card, .layer--art, .layer--poster, .layer--hover-img { transition: opacity 0.2s ease; }
    .gaze-card:hover { transform: none; }
    .gaze-card:hover .layer--art { transform: rotate(0deg) scale(1); }
  }
</style>