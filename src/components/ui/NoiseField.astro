---
// src/components/NoiseField.astro
// membrane.io 风格的背景：SVG feTurbulence 分形噪声 → 拉高对比成黑白烟雾，
// 叠几条极淡虚线。纯程序化，无需图片资源。把内容放进默认 slot，会浮在背景之上。
//
// 用法：
//   <NoiseField>
//     <YourCard />
//   </NoiseField>
//
// 调参：seed 换图案；frequency 越小云块越大；contrast 越大黑白越硬。

interface Props {
  seed?: number;
  frequency?: number;   // 0.008~0.02 之间手感较好
  contrast?: number;    // 线性放大斜率，2.5~4
  class?: string;
}
const { seed = 11, frequency = 0.012, contrast = 3.2, class: cls } = Astro.props;
const fid = `nf-${seed}-${Math.round(frequency * 1000)}`;
const intercept = -(contrast - 1) / 2;   // 让对比围绕中灰展开
---

<div class:list={["nf", cls]}>
  <svg class="nf__noise" aria-hidden="true">
    <filter id={fid}>
      <feTurbulence type="fractalNoise" baseFrequency={frequency} numOctaves="4" seed={seed} stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncR type="linear" slope={contrast} intercept={intercept} />
        <feFuncG type="linear" slope={contrast} intercept={intercept} />
        <feFuncB type="linear" slope={contrast} intercept={intercept} />
      </feComponentTransfer>
    </filter>
    <rect width="100%" height="100%" filter={`url(#${fid})`} />
  </svg>

  <svg class="nf__lines" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
    <g stroke="#6f6f6f" stroke-width="1" stroke-dasharray="6 9" opacity=".26" fill="none">
      <line x1="-40" y1="70" x2="1040" y2="18" />
      <line x1="-40" y1="150" x2="1040" y2="210" />
      <line x1="-40" y1="320" x2="1040" y2="250" />
      <line x1="160" y1="-30" x2="60" y2="430" />
      <line x1="820" y1="-30" x2="900" y2="430" />
    </g>
  </svg>

  <div class="nf__content"><slot /></div>
</div>

<style>
  .nf { position: relative; overflow: hidden; isolation: isolate; }
  .nf__noise,
  .nf__lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .nf__noise { background: #efeee9; }          /* 噪声铺不到的边缘兜底色 */
  .nf__content { position: relative; z-index: 1; }
</style>
