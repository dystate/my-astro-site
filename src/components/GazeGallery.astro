---
// GazeGallery.astro —— 用 CSS Grid 布局,避免卡片塌缩
import GazeCard from "./GazeCard.astro";

const cards = [
  {
    href: "/person",
    image: "/images/art-01.jpg",
    cornerImage: "/images/dst.png", 
    eyebrow: "1",  titleJa: "人类的世界",  subtitle: "感受Feeling", 
  },
  {
    href: "/life",
    image: "/images/art-02.jpg",
    cornerImage: "/images/nature.png", 
    eyebrow: "2",  titleJa: "自然的颜色",  subtitle: "记录Recording", 
  },
  {
    href: "/study",
    image: "/images/art-04.jpg",
    cornerImage: "/images/lg.png", 
    eyebrow: "4",  titleJa: "学习的脚步",  subtitle: "创造Creating",  
  },
  {
    href: "/woaidan",
    image: "/images/art-05.jpg",
    cornerImage: "images/spring.png",
    eyebrow: "5",  titleJa: "永久的春天",  subtitle: "灵魂Elevating", 
  },
];
---

<section class="gaze-gallery" aria-label="作品一覧">
  {cards.map((c, i) => <GazeCard {...c} index={i + 1} />)}
</section>

<style>
  .gaze-gallery {
    display: grid;
    /* 电脑:5 列等宽。minmax(0,1fr) 防止内容把列撑爆 */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* 手机:单列竖排 */
  @media (max-width: 768px) {
    .gaze-gallery {
      grid-template-columns: 1fr;
      gap: 80px;                 /* 卡片间距更大 */
      max-width: 300px;          /* 卡片整体缩小 */
      margin: 56px auto 0;       /* 整体下移,顺便避开顶部 logo */
    }
  }

  
</style>