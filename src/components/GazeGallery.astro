---
// GazeGallery.astro —— 用 CSS Grid 布局,避免卡片塌缩
import GazeCard from "./GazeCard.astro";

const cards = [
  {
    href: "/person",
    image: "/images/art-01.jpg",
    eyebrow: "1",  titleJa: "人类的世界",  subtitle: "感受Feeling", 
    cornerImage: "https://pub-6f84a766ba364e1a8fad794c6cd8561a.r2.dev/5174052c8bc83592b2f1a4c4e77d2b97.png", 
  },
  {
    href: "/works/02",
    image: "/images/art-02.jpg",
    cornerImage: "https://pub-6f84a766ba364e1a8fad794c6cd8561a.r2.dev/2c9a5144962f6116dbf35523fad4ff57.png",
    eyebrow: "2",  titleJa: "自然的颜色",  subtitle: "记录Recording",  coords: "35.0116° N / 135.7681° E",
  },
  {
    href: "/works/03",
    image: "/images/art-03.jpg",
    cornerImage: "/images/01-1.png", 
    eyebrow: "3",  titleJa: "记忆的碎片",  subtitle: "表达Saying",  coords: "34.6937° N / 135.5023° E",
  },
  {
    href: "/works/04",
    image: "/images/art-04.jpg",
    cornerImage: "https://pub-6f84a766ba364e1a8fad794c6cd8561a.r2.dev/f03b39b037f9cb31f1a42e3965873cf4.png", 
    eyebrow: "4",  titleJa: "学习的脚步",  subtitle: "创造Creating",  coords: "35.6762° N / 139.6503° E",
  },
  {
    href: "/woaidan",
    image: "/images/art-05.jpg",
    cornerImage: "images/spring.png",
    eyebrow: "5",  titleJa: "永久的春天",  subtitle: "灵魂Elevating",  coords: "43.0618° N / 141.3545° E",
  },
];
---

<section class="gaze-gallery" aria-label="作品一覧">
  {cards.map((c, i) => <GazeCard {...c} index={i + 1} />)}
</section>

<style>
  .gaze-gallery {
    display: grid;
    /* 电脑:5 列等宽。minmax(0,1fr) 防止内容把列撑爆 */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* 手机:单列竖排 */
  @media (max-width: 768px) {
    .gaze-gallery {
      grid-template-columns: 1fr;
      gap: 80px;                 /* 卡片间距更大 */
      max-width: 300px;          /* 卡片整体缩小 */
      margin: 56px auto 0;       /* 整体下移,顺便避开顶部 logo */
    }
  }

  
</style>