---
import UpdatesNote from "./UpdatesNote.astro";
import LearningNote from "./LearningNote.astro";
import StickyNote from "./StickyNote.astro";
import PhotoFrame from "./PhotoFrame.astro";
---

<section class="board" aria-label="告示栏">
  <div class="slot slot-updates"><UpdatesNote /></div>
  <div class="slot slot-learning"><LearningNote /></div>
  <div class="slot slot-note"><StickyNote /></div>
  <div class="slot slot-photo"><PhotoFrame /></div>
</section>

<style>
  .board {
    /* 设计 token，子组件通过 CSS 变量继承 */
    --ink: #000;
    --paper: #fff;
    --board: #e7ddc6;
    --blue: #2563eb;
    --green: #16a34a;
    --red: #ef4444;
    --yellow: #ffe14d;
    --mono: "Courier Prime", ui-monospace, monospace;

    position: relative;
    border: 4px solid var(--ink);
    background-color: var(--board);
    /* 呼应页面的点阵网格 */
    background-image: radial-gradient(rgba(0, 0, 0, 0.16) 1.4px, transparent 1.4px);
    background-size: 22px 22px;
    box-shadow: 10px 10px 0 0 var(--ink);

    padding: clamp(22px, 3.5vw, 46px);
    display: grid;
    gap: clamp(24px, 3vw, 44px);
    grid-template-columns: 1.7fr 1fr;
    grid-template-areas:
      "updates learning"
      "updates photo"
      "note    photo";
    align-items: start;
  }
  .slot-updates { grid-area: updates; }
  .slot-learning { grid-area: learning; }
  .slot-note { grid-area: note; }
  .slot-photo { grid-area: photo; }

  @media (max-width: 860px) {
    .board {
      grid-template-columns: 1fr;
      grid-template-areas: "updates" "learning" "note" "photo";
      box-shadow: 7px 7px 0 0 var(--ink);
    }
  }
</style>
