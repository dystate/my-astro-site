---
import Paper from "./Paper.astro";
import { learning } from "../../data/board/learning";

const statusText = { doing: "在学", done: "学过", next: "计划" } as const;
---

<Paper rot={2} pin="blue" title="在学 / Learning">
  <ul class="learn">
    {
      learning.map((it) => (
        <li class={`learn-item s-${it.status ?? "doing"}`}>
          <span class="box" aria-hidden="true" />
          <span class="label">{it.label}</span>
          {it.status && <span class="badge">{statusText[it.status]}</span>}
        </li>
      ))
    }
  </ul>
</Paper>

<style>
  .learn { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .learn-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono, monospace);
    font-size: 0.85rem;
    color: #000;
  }
  .box {
    width: 14px;
    height: 14px;
    flex: none;
    border: 2px solid #000;
    background: #fff;
  }
  .s-doing .box { background: #2563eb; }
  .s-done .box { background: #16a34a; }
  .s-next .box { background: #fff; }

  .label { flex: 1; }
  .s-done .label { text-decoration: line-through; color: #555; }

  .badge {
    flex: none;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.08rem 0.4rem;
    border: 2px solid #000;
    background: #fff;
  }
  .s-doing .badge { background: #dbeafe; }
  .s-done .badge { background: #dcfce7; }
  .s-next .badge { background: #f0f0f0; }
</style>
