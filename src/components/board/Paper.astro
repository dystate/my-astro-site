---
// 新粗野风「卡片」外壳：硬黑边 + 硬偏移阴影 + 图钉/胶带 + 轻微旋转 + 按压 hover
interface Props {
  rot?: number;
  pin?: "red" | "blue" | "yellow" | "tape" | "none";
  title?: string;
  class?: string;
}
const { rot = 0, pin = "red", title, class: extra = "" } = Astro.props;
---

<div class={`card-wrap ${extra}`} style={`--rot:${rot}deg`}>
  {pin === "tape" && <span class="tape" aria-hidden="true"></span>}
  {pin !== "tape" && pin !== "none" && (
    <span class={`pin pin-${pin}`} aria-hidden="true"></span>
  )}

  <article class="card">
    {title && <h3 class="card-title">{title}</h3>}
    <div class="card-body"><slot /></div>
  </article>
</div>

<style>
  .card-wrap {
    --rot: 0deg;
    position: relative;
    transform: rotate(var(--rot));
  }
  .card {
    position: relative;
    border: 3px solid #000;
    background: #fff;
    box-shadow: 6px 6px 0 0 #000;
    padding: 1.4rem 1.3rem 1.3rem;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  /* 按压：往阴影方向位移，阴影变小 */
  .card-wrap:hover .card {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 0 #000;
  }

  .card-title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.55rem;
    font-family: var(--mono, "Courier Prime", monospace);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.3rem);
    color: #000;
    border-bottom: 3px solid #000;
  }
  .card-body {
    font-family: var(--mono, "Courier Prime", monospace);
    font-size: 0.86rem;
    line-height: 1.5;
    color: #111;
  }

  /* 图钉 */
  .pin {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translateX(-50%);
    border: 3px solid #000;
    border-radius: 50%;
    box-shadow: 2px 2px 0 0 #000;
    z-index: 3;
  }
  .pin-red { background: #ef4444; }
  .pin-blue { background: #2563eb; }
  .pin-yellow { background: #ffe14d; }

  /* 胶带 */
  .tape {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 84px;
    height: 26px;
    transform: translateX(-50%) rotate(-3deg);
    background: #ffe14d;
    border: 3px solid #000;
    box-shadow: 2px 2px 0 0 #000;
    z-index: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>
