---
import Paper from "./Paper.astro";
import { getCollection, render } from "astro:content";

// 拉取更新集合，过滤草稿，按日期倒序
const entries = (
  await getCollection("updates", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 预渲染每条的 Markdown 正文（无法在模板的 map 里 await，所以先在这里处理好）
const items = await Promise.all(
  entries.map(async (e) => ({
    data: e.data,
    Content: (await render(e)).Content,
  }))
);

// 用 UTC 取值，避免时区把 2026-06-10 显示成前一天
const fmt = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, "0")}.${String(
    d.getUTCDate()
  ).padStart(2, "0")}`;
---

<Paper rot={-1.5} pin="red" title="更新 / News">
  <ul class="updates">
    {
      items.map(({ data, Content }) => (
        <li class="update">
          <span class="date">{fmt(data.date)}</span>
          <h4 class="u-title">{data.title}</h4>
          <div class="u-body">
            <Content />
          </div>
          {data.link && (
            <a class="u-link" href={data.link.href}>
              {data.link.label} →
            </a>
          )}
        </li>
      ))
    }
  </ul>
</Paper>

<style>
  .updates { list-style: none; margin: 0; padding: 0; }
  .update {
    padding: 0.85rem 0;
    border-top: 2px solid #000;
  }
  .update:first-child { padding-top: 0; border-top: 0; }

  .date {
    display: inline-block;
    background: #000;
    color: #fff;
    font-family: var(--mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.12rem 0.45rem;
  }
  .u-title {
    margin: 0.45rem 0 0.2rem;
    font-family: var(--mono, monospace);
    font-size: 0.95rem;
    font-weight: 700;
    color: #000;
  }

  /* Markdown 正文：<Content /> 输出不受 scoped 样式约束，用 :global 收一下 */
  .u-body { color: #222; }
  .u-body :global(p) { margin: 0; }
  .u-body :global(p + p) { margin-top: 0.5rem; }
  .u-body :global(a) { color: #000; }

  .u-link {
    display: inline-block;
    margin-top: 0.55rem;
    font-family: var(--mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    color: #000;
    background: #fff;
    border: 2px solid #000;
    padding: 0.15rem 0.5rem;
    box-shadow: 3px 3px 0 0 #000;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .u-link:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 0 #000; }
  .u-link:active { transform: translate(3px, 3px); box-shadow: 0 0 0 0 #000; }

  @media (prefers-reduced-motion: reduce) {
    .u-link { transition: none; }
  }
</style>
