---
import { note } from "../../data/note";
---

<div class="sticky" style="--rot:-2deg">
  <span class="pin" aria-hidden="true"></span>
  <div class="sticky-inner">
    {note.lines.map((l) => <p class="line">{l}</p>)}
    <p class="sign">
      — {note.signature}{note.date ? `，${note.date}` : ""}
    </p>
  </div>
</div>

<style>
  .sticky {
    --rot: 0deg;
    position: relative;
    transform: rotate(var(--rot));
    border: 3px solid #000;
    background: #ffe14d;
    box-shadow: 6px 6px 0 0 #000;
    padding: 1.3rem 1.2rem;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .sticky:hover {
    transform: rotate(var(--rot)) translate(3px, 3px);
    box-shadow: 3px 3px 0 0 #000;
  }

  .sticky-inner {
    font-family: var(--mono, "Courier Prime", monospace);
    color: #1a1a1a;
  }
  .line { margin: 0 0 0.3rem; font-size: 0.92rem; line-height: 1.5; }
  .sign { margin: 0.7rem 0 0; text-align: right; font-weight: 700; font-size: 0.85rem; }

  .pin {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translateX(-50%);
    border: 3px solid #000;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 2px 2px 0 0 #000;
    z-index: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky { transition: none; }
  }
</style>
