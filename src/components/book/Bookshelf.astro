---
/**
 * Bookshelf.astro —— 书架页（原 /woaidan 页面，已迁入 NEW JOURNEY 详情页）
 *
 * 无登录拦截：打开即见书架。点击书脊 → 跳转该书的详情页 /album/book/<slug>，
 * 翻书器已抽为独立组件 BookReader.astro（以小组件形式嵌在详情页里）。
 * 书本数据来自 src/data/books.ts。
 *
 * 用法：
 *   <Bookshelf />
 */
import SiteNav from "../SiteNav.astro";
import { books as booksData } from "../../data/books";
import { bookVisual } from "./visual";

/* ========== 1. 给每本书补上 id ========== */
booksData.forEach((b, i) => (b.id = i));
booksData.sort((a, b) => (a.order ?? 9999) - (b.order ?? 9999) || a.name.localeCompare(b.name));

// 全部书放在同一层（一层书架）
const shelves = [booksData];
---

{/* 全局 CRT 质感叠层 */}
<div class="crt-scan" aria-hidden="true"></div>
<div class="crt-vignette" aria-hidden="true"></div>

{/* 顶部导航（design.md §5.3 Album 模式） */}
<header class="site-header">
  <a class="site-logo dystate-brand" href="/">Dystate</a>
  <nav class="site-nav" aria-label="导航">
    <SiteNav />
  </nav>
  <button class="menu-btn site-menu-label site-menu-corner" id="menu-open" aria-label="打开菜单">
    MENU
    <span class="px">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="10" y="0" width="4" height="4" fill="currentColor"/><rect x="10" y="5" width="4" height="4" fill="currentColor"/>
        <rect x="10" y="10" width="4" height="4" fill="currentColor"/><rect x="10" y="15" width="4" height="4" fill="currentColor"/>
        <rect x="10" y="20" width="4" height="4" fill="currentColor"/><rect x="0" y="10" width="4" height="4" fill="currentColor"/>
        <rect x="5" y="10" width="4" height="4" fill="currentColor"/><rect x="15" y="10" width="4" height="4" fill="currentColor"/>
        <rect x="20" y="10" width="4" height="4" fill="currentColor"/>
      </svg>
    </span>
  </button>
</header>

{/* 移动端全屏菜单（design.md §5.2） */}
<div class="m-menu" id="m-menu" aria-hidden="true">
  <div class="m-menu-top">
    <span class="site-logo dystate-brand">Dystate</span>
    <button class="m-menu-x site-menu-label site-menu-corner" id="menu-close" aria-label="关闭菜单">
      CLOSE
      <span class="px">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="10" y="0" width="4" height="4" fill="currentColor"/><rect x="10" y="5" width="4" height="4" fill="currentColor"/>
          <rect x="10" y="10" width="4" height="4" fill="currentColor"/><rect x="10" y="15" width="4" height="4" fill="currentColor"/>
          <rect x="10" y="20" width="4" height="4" fill="currentColor"/><rect x="0" y="10" width="4" height="4" fill="currentColor"/>
          <rect x="5" y="10" width="4" height="4" fill="currentColor"/><rect x="15" y="10" width="4" height="4" fill="currentColor"/>
          <rect x="20" y="10" width="4" height="4" fill="currentColor"/>
        </svg>
      </span>
    </button>
  </div>
  <nav>
    <SiteNav />
  </nav>
</div>

{/* 书柜 */}
<div class="bookcase">
  <div class="bg-mark" aria-hidden="true">2026起</div>
  {shelves.map((shelf) => (
    <div class="shelf">
      <div class="books">
        {shelf.map((book) => {
          const v = bookVisual(book.id!, book.name);
          const href = `/album/book/${book.slug ?? book.id}`;
          return (
            <a class="book" href={href} data-book-id={book.id} style={`--c:${v.color}; --ink:${v.ink}; --w:${v.w}px; --h:${v.h}%;`} aria-label={`打开 ${book.name || '未命名'}`}>
              <span class="spine-num">{String(book.id! + 1).padStart(2, '0')}</span>
              <span class="spine-title">{book.name || '未命名'}</span>
              <span class="spine-tag">No.{book.id! + 1}</span>
            </a>
          );
        })}
      </div>
      <div class="board"></div>
    </div>
  ))}
</div>

{/* 四角线框 */}
<div class="poster-corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>

{/* 移动端菜单交互（vanilla） */}
<script is:inline>
  (function () {
    var openBtn = document.getElementById('menu-open');
    var closeBtn = document.getElementById('menu-close');
    var menu = document.getElementById('m-menu');
    if (!openBtn || !menu) return;
    function open() { menu.classList.add('open'); menu.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    function close() { menu.classList.remove('open'); menu.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    openBtn.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    menu.querySelectorAll('nav a').forEach(function (a) { a.addEventListener('click', close); });
  })();
</script>

<style is:global>
  /* ============================================================
     Dystate · 书架 —— 深色 CRT 主题（遵循 design.md）
     点书跳转书籍详情页；翻书器见 BookReader.astro。
     ============================================================ */
  :root{
    --bg:#000; --ink:#fff;
    --phosphor:#73F59A; --phosphor-dim:#3FA968;
    --accent:#5451f2; --teal:#6fb6c9; --orange:#e0552b;
    --ease: cubic-bezier(.16,1,.3,1);
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background:#000; color:#fff; overflow:hidden;
    font-family:'Open Sans',sans-serif;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    -webkit-user-select:none; user-select:none;
  }

  /* ---------- 全局点阵质感 ---------- */
  .crt-scan{ position:fixed; inset:0; z-index:8; pointer-events:none;
    background-image:radial-gradient(circle, rgba(0,0,0,.08) 0.5px, transparent 1px);
    background-size:12px 12px; }
  .crt-vignette{ position:fixed; inset:0; z-index:8; pointer-events:none;
    background:radial-gradient(120% 120% at 50% 40%, transparent 58%, rgba(0,0,0,.6)); }

  /* ---------- Header（design.md §5.3 Album 模式） ---------- */
  .site-header{ position:fixed; top:0; inset-inline:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px; pointer-events:none;
    background:linear-gradient(to bottom, rgba(0,0,0,.92), rgba(0,0,0,0)); }
  .site-header > *{ pointer-events:auto; }
  .site-logo{ color:#fff; text-decoration:none; }
  .site-nav{ display:none; align-items:center; gap:32px; }
  .site-nav a{ font:800 18px/1 'Open Sans',sans-serif; letter-spacing:.04em; color:#fff; text-decoration:none; transition:opacity .2s; }
  .site-nav a:hover{ opacity:.6; }
  .menu-btn{ display:flex; align-items:center; gap:8px; background:none; border:none; cursor:pointer;
    color:#fff; font:800 22px/1 'Open Sans',sans-serif; letter-spacing:.04em; z-index:80; }
  .menu-btn .px, .m-menu-x .px{ display:inline-flex; }
  @media (min-width:640px){
    .site-nav{ display:flex; }
    .menu-btn{ display:none; }
  }

  /* ---------- 移动端全屏菜单（design.md §5.2） ---------- */
  .m-menu{ position:fixed; inset:0; z-index:70; display:flex; flex-direction:column;
    background:#000; color:#fff; opacity:0; pointer-events:none; transition:opacity .3s var(--ease); }
  .m-menu.open{ opacity:1; pointer-events:auto; }
  .m-menu-top{ display:flex; align-items:center; justify-content:space-between; padding:16px; }
  .m-menu-x{ display:flex; align-items:center; gap:8px; background:none; border:none; cursor:pointer;
    color:#fff; font:800 22px/1 'Open Sans',sans-serif; letter-spacing:.04em; }
  .m-menu-x .px{ transition:transform .3s var(--ease); }
  .m-menu.open .m-menu-x .px{ transform:rotate(45deg); }
  .m-menu nav{ flex:1; display:flex; flex-direction:column; align-items:flex-end; justify-content:center; padding:0 16px; }
  .m-menu nav a{ font:800 64px/.95 'Open Sans',sans-serif; letter-spacing:-.02em; color:#fff; text-decoration:none;
    opacity:0; transform:translateY(24px); transition:opacity .5s var(--ease), transform .5s var(--ease); }
  .m-menu.open nav a{ opacity:1; transform:none; }
  .m-menu.open nav a:nth-child(1){ transition-delay:.10s; }
  .m-menu.open nav a:nth-child(2){ transition-delay:.18s; }
  .m-menu.open nav a:nth-child(3){ transition-delay:.26s; }

  /* ---------- 书柜 ---------- */
  .bookcase{
    height:100vh; height:100dvh; width:100vw; position:relative;
    overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch;
    display:flex; flex-direction:column; justify-content:center; gap:clamp(10px,3.2vh,26px);
    padding: max(96px, env(safe-area-inset-top)) 0 max(104px, env(safe-area-inset-bottom)); box-sizing:border-box;
    background:radial-gradient(120% 120% at 50% 38%, #0c1410 0%, #060a08 55%, #000 100%);
  }
  /* 背景水印 */
  .bg-mark{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    z-index:0; pointer-events:none; user-select:none; white-space:nowrap;
    font:italic 400 clamp(72px,20vw,240px)/1 'Instrument Serif',serif;
    letter-spacing:-2px; color:rgba(255,255,255,.05); }

  .shelf{ width:min(94vw,760px); margin:0 auto; display:flex; flex-direction:column; position:relative; z-index:1; }
  .books{ display:flex; align-items:flex-end; justify-content:center; gap:5px;
    min-height:clamp(120px,22vh,190px); padding:0 6px; overflow-x:auto; overflow-y:visible; scrollbar-width:none; }
  .books::-webkit-scrollbar{ display:none; }

  /* 书架横板：硬边 neo-brutalist + 一丝磷光 */
  .board{ height:12px; background:#0a0a0a; border-top:1px solid rgba(115,245,154,.22);
    box-shadow:0 -4px 0 rgba(255,255,255,.04) inset, 0 14px 26px -10px rgba(0,0,0,.95); }

  .book{
    flex:0 0 auto; width:var(--w); height:var(--h); max-height:clamp(120px,22vh,190px);
    position:relative; padding:9px 0 7px; cursor:pointer; color:var(--ink); border-radius:2px 2px 0 0;
    text-decoration:none;
    background:var(--c);
    box-shadow:0 0 0 1px rgba(0,0,0,.45) inset, 2px 10px 16px -6px rgba(0,0,0,.9);
    -webkit-box-reflect:below 1px linear-gradient(transparent, transparent 78%, rgba(0,0,0,.18));
    transition:transform .28s var(--ease), box-shadow .28s, filter .28s;
    display:flex; flex-direction:column; align-items:center; justify-content:space-between; transform-origin:bottom center;
  }
  .book::after{ content:""; position:absolute; top:0; bottom:0; left:0; width:3px; background:rgba(255,255,255,.14); }
  .book::before{ content:""; position:absolute; top:0; bottom:0; right:0; width:5px; background:rgba(0,0,0,.35); }
  .book:hover{ transform:translateY(-10px);
    box-shadow:0 0 0 1px rgba(115,245,154,.45) inset, 2px 16px 24px -6px rgba(0,0,0,.95), 0 0 20px -2px rgba(115,245,154,.22); }
  .spine-num{ font:700 10px/1 'Nokia Cellphone FC Small',ui-monospace,"SFMono-Regular",monospace; letter-spacing:.5px;
    padding:1px 4px; border-radius:2px; border:1px solid currentColor; opacity:.82; color:inherit; pointer-events:none; }
  .spine-title{ writing-mode:vertical-rl; text-orientation:mixed; font:500 13px/1.1 "Noto Serif SC","Songti SC",serif;
    letter-spacing:3px; white-space:nowrap; overflow:hidden; flex:1; display:flex; align-items:center; margin:6px 0;
    color:inherit; text-shadow:0 1px 1px rgba(0,0,0,.4); pointer-events:none; }
  .spine-tag{ font:600 8px/1 'Nokia Cellphone FC Small',ui-monospace,"SFMono-Regular",monospace; letter-spacing:.3px; opacity:.72; color:inherit; pointer-events:none; }

  /* 四角线框装饰（白线，design 海报感） */
  .poster-corners{ position:fixed; inset:16px; pointer-events:none; z-index:6; }
  .poster-corners i{ position:absolute; width:26px; height:26px; border:1.5px solid rgba(255,255,255,.22); }
  .poster-corners i.tl{ top:0; left:0; border-right:0; border-bottom:0; }
  .poster-corners i.tr{ top:0; right:0; border-left:0; border-bottom:0; }
  .poster-corners i.bl{ bottom:0; left:0; border-right:0; border-top:0; }
  .poster-corners i.br{ bottom:0; right:0; border-left:0; border-top:0; }

  /* ---------- 手机端 ---------- */
  @media (max-width:760px){
    .bookcase{ gap:clamp(8px,2.4vh,18px); }
    .shelf{ width:96vw; }
    .books{ gap:2px; min-height:clamp(110px,20vh,160px); }
    .book{ max-height:clamp(110px,20vh,160px); }
    .poster-corners{ inset:10px; }
    .poster-corners i{ width:18px; height:18px; }
  }

  /* ---------- 减少动画偏好 ---------- */
  @media (prefers-reduced-motion: reduce){
    .book{ transition:none; }
    .m-menu, .m-menu nav a{ transition:none; transform:none; }
  }
</style>
