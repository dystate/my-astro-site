---
// src/pages/person.astro
// 板块数据各自放在 src/data/*.ts，这里只负责导入 + 渲染。
// 全部板块走朋友圈发布流样式。新增/删除板块：改下面的 import 和 sections 顺序即可。

import { music,   meta as musicMeta }   from "../data/person/music";
import { video,   meta as videoMeta }   from "../data/person/video";
import { photos,  meta as photosMeta }  from "../data/person/photos";
import { diary,   meta as diaryMeta }   from "../data/person/diary";
import { cooking, meta as cookingMeta } from "../data/person/cooking";
import CommentSection from "../components/CommentSection";

const author = { name: "宇宙无敌dddst", initial: "D" };

// 导航顺序
const sections = [musicMeta, videoMeta, photosMeta, diaryMeta, cookingMeta];
const defaultId = "music";

// 复用的页脚（时间 / 删除 / 更多）由组件内联，这里不抽提
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>person</title>
  </head>
  <body>
    <div class="stage" data-active={defaultId} data-open="false" data-menu="false">
      <button class="switch" id="switch" aria-label="开关 / 切换板块" aria-expanded="false">
        <span class="switch__lever"></span>
        <span class="switch__label">PERSON</span>
      </button>

      <nav class="menu" id="menu" aria-label="板块">
        <svg class="menu__curve" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path id="menu-curve-path" d="M100 0 L100 100 Q40 50 100 0 Z" />
        </svg>
        <div class="menu__inner">
          <p class="menu__label">Navigation</p>
          <ul class="menu__list">
            {sections.map((s, i) => (
              <li>
                <button class="menu__item" data-target={s.id} type="button">
                  <span class="menu__num">{i + 1}.</span>
                  <span class="menu__head">
                    {[...s.label].map((ch, j) => (
                      <span class="menu__char" style={`--j:${j}`}>{ch}</span>
                    ))}
                  </span>
                  <span class="menu__en">{s.en}</span>
                </button>
              </li>
            ))}
          </ul>
          <div class="menu__footer">
            {/* 社交/外链占位，把 href 换成你的即可 */}
            <a href="#" aria-label="GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.82 1.19 1.85 1.19 3.11 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg></a>
            <a href="#" aria-label="Email"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
            <a href="#" aria-label="Site"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></a>
          </div>
        </div>
      </nav>

      <main class="content">
        {/* —— 音乐 —— */}
        <section class="panel" data-panel="music">
          <div class="feed">
            {music.map((m) => (
              <article class="post post--music" data-duration={m.duration}>
                <header class="post__head">
                  <span class="post__avatar">{author.initial}</span>
                  <span class="post__name">{author.name}</span>
                </header>
                <div class="post__card" style={`--tint:${m.tint}`}>
                  <span class="post__note">♪</span>
                  <h3 class="post__song">{m.title}<span class="post__star">★</span></h3>
                  <p class="post__artist">{m.artist}</p>
                  <button class="post__play" data-play type="button">
                    <span class="post__play-icon"></span><span class="post__play-text"></span>
                  </button>
                  <div class="post__progress"><div class="post__bar" data-bar></div></div>
                </div>
                <footer class="post__foot">
                  <span class="post__time">{m.time}</span>
                  <button class="post__trash" type="button" aria-label="删除"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg></button>
                  <button class="post__more" type="button" aria-label="更多">···</button>
                </footer>
              </article>
            ))}
          </div>
        </section>

        {/* —— 视频（封面自动取开头一帧）—— */}
        <section class="panel" data-panel="video">
          <div class="feed">
            {video.map((v) => (
              <article class="post post--video">
                <header class="post__head">
                  <span class="post__avatar">{author.initial}</span>
                  <span class="post__name">{author.name}</span>
                </header>
                <div class="post__media">
                  <video class="post__video" data-video src={`${v.src}#t=0.1`} preload="metadata" playsinline></video>
                  <button class="post__videoplay" data-play type="button" aria-label="播放"><span class="post__tri"></span></button>
                  <div class="post__progress"><div class="post__bar" data-bar></div></div>
                </div>
                {v.title && <p class="post__vtitle">{v.title}</p>}
                <footer class="post__foot">
                  <span class="post__time">{v.time}</span>
                  <button class="post__trash" type="button" aria-label="删除"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg></button>
                  <button class="post__more" type="button" aria-label="更多">···</button>
                </footer>
              </article>
            ))}
          </div>
        </section>

        {/* —— 照片 —— */}
        <section class="panel" data-panel="photos">
          {photos.length ? (
            <div class="feed">
              {photos.map((p) => (
                <article class="post">
                  <header class="post__head"><span class="post__avatar">{author.initial}</span><span class="post__name">{author.name}</span></header>
                  {p.caption && <p class="post__caption">{p.caption}</p>}
                  <div class={`post__grid n${Math.min(p.images.length, 3)}`}>
                    {p.images.map((src) => <img class="post__photo" src={src} alt="" loading="lazy" />)}
                  </div>
                  <footer class="post__foot">
                    <span class="post__time">{p.time}</span>
                    <button class="post__more" type="button" aria-label="更多">···</button>
                  </footer>
                </article>
              ))}
            </div>
          ) : (
            <div class="placeholder"><span>Photographs</span><h2>照片</h2><p>内容待填充</p></div>
          )}
        </section>

        {/* —— 日记（文字流）—— */}
        <section class="panel" data-panel="diary">
          <div class="feed">
            {diary.map((d) => (
              <article class="post">
                <header class="post__head"><span class="post__avatar">{author.initial}</span><span class="post__name">{author.name}</span></header>
                <div class="post__text">
                  {d.date && <span class="post__date">{d.date}</span>}
                  <p>{d.body}</p>
                </div>
                <CommentSection postId={d.id} client:load />
                <footer class="post__foot">
                  <span class="post__time">{d.time}</span>
                  <button class="post__more" type="button" aria-label="更多">···</button>
                </footer>
              </article>
            ))}
          </div>
        </section>

        {/* —— 厨艺 —— */}
        <section class="panel" data-panel="cooking">
          {cooking.length ? (
            <div class="feed">
              {cooking.map((c) => (
                <article class="post">
                  <header class="post__head"><span class="post__avatar">{author.initial}</span><span class="post__name">{author.name}</span></header>
                  {c.note && <p class="post__caption">{c.note}</p>}
                  {c.image && <div class="post__grid n1"><img class="post__photo" src={c.image} alt={c.dish} loading="lazy" /></div>}
                  <p class="post__caption" style="opacity:.85;font-weight:600">{c.dish}</p>
                  <footer class="post__foot"><span class="post__time">{c.time}</span><button class="post__more" type="button" aria-label="更多">···</button></footer>
                </article>
              ))}
            </div>
          ) : (
            <div class="placeholder"><span>Cooking</span><h2>厨艺</h2><p>内容待填充</p></div>
          )}
        </section>
      </main>
    </div>

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; background: #121212; }
      html { scrollbar-width: none; -ms-overflow-style: none; }
      html::-webkit-scrollbar { display: none; }

      /* Frutiger 是商业授权字体，仓库里不含字体文件。取得授权后把 woff2 放到
         public/fonts/ 下，取消下面注释即可启用；未启用时回退到 Segoe UI 等近似无衬线。
      @font-face {
        font-family: "Frutiger"; font-weight: 400; font-display: swap;
        src: url("/fonts/Frutiger-Roman.woff2") format("woff2");
      }
      @font-face {
        font-family: "Frutiger"; font-weight: 700; font-display: swap;
        src: url("/fonts/Frutiger-Bold.woff2") format("woff2");
      }
      */

      :root {
        --bg-on: #e7e4de; --fg-on: #1a1a1a; --bg-off: #121212; --fg-off: #8a8a8a;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      .stage {
        position: relative; height: 100vh; overflow: hidden;
        background: var(--bg-off); color: var(--fg-off);
        font-family: "Frutiger", "Frutiger Neue LT", "Segoe UI", "Helvetica Neue", "PingFang SC", system-ui, sans-serif;
        transition: background .5s var(--ease), color .5s var(--ease);
      }
      .stage[data-open="true"] { background: var(--bg-on); color: var(--fg-on); }

      .switch { position: fixed; top: 24px; left: 24px; z-index: 20; display: inline-flex; align-items: center; gap: 12px; padding: 8px 10px; border: none; background: transparent; color: inherit; cursor: pointer; font: inherit; }
      .switch__lever { position: relative; width: 26px; height: 44px; border-radius: 13px; background: rgba(255,255,255,.12); border: 1px solid currentColor; }
      .switch__lever::after { content: ""; position: absolute; left: 50%; bottom: 4px; transform: translateX(-50%); width: 16px; height: 16px; border-radius: 50%; background: currentColor; transition: bottom .3s var(--ease); }
      .stage[data-open="true"] .switch__lever::after { bottom: 22px; }
      .switch__label { letter-spacing: .18em; font-size: 13px; font-weight: 600; }

      /* —— 曲边菜单（从右滑入）—— */
      :root { --menu-bg: #f6f4ee; --menu-fg: #161616; }
      .menu {
        position: fixed; top: 0; right: 0; z-index: 25;
        height: 100dvh; width: 100%; max-width: 560px;
        background: var(--menu-bg); color: var(--menu-fg);
        transform: translateX(calc(100% + 120px));
        transition: transform .8s cubic-bezier(.76,0,.24,1);
        filter: drop-shadow(-14px 0 34px rgba(0,0,0,.16));
        will-change: transform;
      }
      .stage[data-menu="true"] .menu { transform: translateX(0); }
      .menu__curve { position: absolute; top: 0; left: -99px; width: 100px; height: 100%; fill: var(--menu-bg); stroke: none; }

      .menu__inner { height: 100%; padding: 64px 44px 26px; display: flex; flex-direction: column; }
      .menu__label { margin: 0 0 6px; padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,.28); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
      .menu__list { list-style: none; margin: 8px 0 0; padding: 0; flex: 1; }
      .menu__item {
        width: 100%; display: flex; align-items: center; gap: 14px;
        padding: clamp(14px, 3vh, 30px) 0; border: none; border-bottom: 1px solid rgba(0,0,0,.22);
        background: transparent; color: inherit; cursor: pointer; font: inherit; text-align: left;
      }
      .menu__num { font-size: 22px; font-weight: 300; opacity: .55; }
      .menu__head { font-size: clamp(30px, 7vw, 46px); font-weight: 200; line-height: 1; }
      .menu__char { display: inline-block; transition: transform .45s cubic-bezier(.76,0,.24,1); transition-delay: calc(var(--j) * .03s); }
      .menu__item:hover .menu__char { transform: translateX(calc((var(--j) + 1) * 7px)); }
      .menu__en { margin-left: auto; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; opacity: .5; }
      .menu__item.is-current .menu__num,
      .menu__item.is-current .menu__en { opacity: 1; }
      .menu__item.is-current .menu__head { font-weight: 400; }

      .menu__footer { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; }
      .menu__footer a { color: inherit; opacity: .7; transition: opacity .2s var(--ease); }
      .menu__footer a:hover { opacity: 1; }

      .content { height: 100vh; overflow-y: auto; padding: 118px 24px 60px; opacity: 0; pointer-events: none; transition: opacity .5s var(--ease); scrollbar-width: none; -ms-overflow-style: none; }
      .content::-webkit-scrollbar { display: none; }
      .stage[data-open="true"] .content { opacity: 1; pointer-events: auto; }

      .panel { display: none; }
      .panel.is-active { display: block; }

      .placeholder { max-width: 720px; margin: 40px auto 0; text-align: center; }
      .placeholder span { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; opacity: .5; }
      .placeholder h2 { margin: 8px 0 4px; font-size: 40px; font-weight: 600; }
      .placeholder p { font-size: 13px; opacity: .45; }

      /* —— 朋友圈流 —— */
      .feed { max-width: 460px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; }
      .post__head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
      .post__avatar { width: 34px; height: 34px; border-radius: 7px; background: #b7a98f; color: #fff; font-size: 15px; font-weight: 600; display: grid; place-items: center; flex: none; }
      .post__name { font-size: 15px; font-weight: 600; color: #4a5a78; }
      .post__foot { display: flex; align-items: center; gap: 14px; margin-top: 10px; padding: 0 2px; }
      .post__time { font-size: 13px; color: #9a958c; }
      .post__trash { border: none; background: transparent; color: #9a958c; cursor: pointer; padding: 2px; display: inline-flex; }
      .post__more { margin-left: auto; border: none; cursor: pointer; background: rgba(0,0,0,.05); color: #6b6b6b; border-radius: 8px; padding: 2px 12px; font-size: 16px; line-height: 1; letter-spacing: 1px; }

      /* 音乐卡片 */
      .post__card { position: relative; overflow: hidden; border-radius: 14px; padding: 20px 20px 22px; background-color: var(--tint); background-image: linear-gradient(160deg, rgba(255,255,255,.10), rgba(0,0,0,.22)); color: #fff; }
      .post__note { position: absolute; top: 16px; right: 18px; font-size: 20px; opacity: .8; }
      .post__song { margin: 0; font-size: 19px; font-weight: 700; display: flex; align-items: center; gap: 6px; }
      .post__star { font-size: 13px; opacity: .85; }
      .post__artist { margin: 4px 0 16px; font-size: 14px; opacity: .78; }
      .post__play { display: inline-flex; align-items: center; gap: 7px; padding: 7px 16px 7px 13px; border: none; border-radius: 999px; background: rgba(255,255,255,.88); color: #2b2b2b; font-size: 14px; font-weight: 600; cursor: pointer; }
      .post__play:hover { background: #fff; }
      .post__play-icon::before { content: "▶"; font-size: 11px; }
      .post.is-playing .post__play-icon::before { content: "❚❚"; letter-spacing: -1px; }
      .post__play-text::before { content: "播放"; }
      .post.is-playing .post__play-text::before { content: "暂停"; }

      /* 进度条（音乐卡片 + 视频共用）*/
      .post__progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255,255,255,.18); opacity: 0; transition: opacity .3s var(--ease); }
      .post.played .post__progress { opacity: 1; }
      .post__bar { height: 100%; width: 0; background: rgba(255,255,255,.92); }

      /* 视频 */
      .post__media { position: relative; overflow: hidden; border-radius: 14px; background: #1f1f1f; aspect-ratio: 1 / 1; }
      .post__video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .post__videoplay { position: absolute; inset: 0; margin: auto; width: 56px; height: 56px; border: none; border-radius: 50%; background: rgba(0,0,0,.42); display: grid; place-items: center; cursor: pointer; transition: opacity .25s var(--ease); }
      .post.is-playing .post__videoplay { opacity: 0; pointer-events: none; }
      .post__tri { width: 0; height: 0; border-style: solid; border-width: 9px 0 9px 15px; border-color: transparent transparent transparent #fff; margin-left: 3px; }
      .post__vtitle { margin: 10px 2px 0; font-size: 15px; }

      /* 照片 / 厨艺 图片网格 */
      .post__caption { margin: 0 2px 10px; font-size: 15px; line-height: 1.6; }
      .post__grid { display: grid; gap: 4px; border-radius: 12px; overflow: hidden; }
      .post__grid.n1 { grid-template-columns: 1fr; }
      .post__grid.n2 { grid-template-columns: 1fr 1fr; }
      .post__grid.n3 { grid-template-columns: 1fr 1fr 1fr; }
      .post__photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
      .post__grid.n1 .post__photo { aspect-ratio: 4 / 3; }

      /* 日记 文字卡 */
      .post__text { background: rgba(0,0,0,.035); border-radius: 14px; padding: 16px 18px; }
      .post__date { font-size: 12px; letter-spacing: .1em; opacity: .5; }
      .post__text p { margin: 6px 0 0; line-height: 1.75; font-size: 15px; color: #2c2c2c; }

      @media (max-width: 600px) {
        .switch { top: 16px; left: 16px; z-index: 30; }
        .content { padding-top: 84px; }
        .menu { max-width: 100%; filter: none; }
        .menu__inner { padding: 76px 28px 24px; }
      }
    </style>

    <script>
      const stage = document.querySelector(".stage");
      const switchBtn = document.getElementById("switch");
      const navItems = document.querySelectorAll(".menu__item");
      const panels = document.querySelectorAll(".panel");
      const curvePath = document.getElementById("menu-curve-path");

      function setActive(id) {
        stage.dataset.active = id;
        panels.forEach((p) => p.classList.toggle("is-active", p.dataset.panel === id));
        navItems.forEach((n) => n.classList.toggle("is-current", n.dataset.target === id));
      }

      // 曲边形变：打开时凸起回弹到平缓，关闭时反向
      const CURVE_REST = 88, CURVE_BULGE = 40;
      let curveRAF = null;
      const easeIO = (t) => (t < .5 ? 8*t*t*t*t : 1 - Math.pow(-2*t + 2, 4) / 2);
      function curveD(cx) { return `M100 0 L100 100 Q${cx.toFixed(1)} 50 100 0 Z`; }
      function animateCurve(from, to, dur = 800) {
        if (curveRAF) cancelAnimationFrame(curveRAF);
        const start = performance.now();
        (function step(now) {
          const t = Math.min((now - start) / dur, 1);
          curvePath.setAttribute("d", curveD(from + (to - from) * easeIO(t)));
          if (t < 1) curveRAF = requestAnimationFrame(step);
        })(start);
      }

      function setMenu(open) {
        stage.dataset.menu = String(open);
        animateCurve(open ? CURVE_BULGE : CURVE_REST, open ? CURVE_REST : CURVE_BULGE);
      }
      function setOpen(open) {
        stage.dataset.open = String(open);
        switchBtn.setAttribute("aria-expanded", String(open));
        if (!open) stage.dataset.menu = "false";
      }

      // 开关：未开灯则开灯并弹出菜单；已开灯则切换菜单显隐
      switchBtn.addEventListener("click", () => {
        if (stage.dataset.open !== "true") { setOpen(true); setMenu(true); }
        else { setMenu(stage.dataset.menu !== "true"); }
      });
      navItems.forEach((item) => item.addEventListener("click", () => {
        setActive(item.dataset.target);
        setMenu(false);               // 选完收起菜单，露出内容
      }));
      setActive(stage.dataset.active);

      // —— 播放：音乐 + 视频共用一个“同时只播一个”的开关 ——
      let playing = null;   // 当前在播的 { pause() }
      let raf = null;       // 仅音乐进度动画用

      // 音乐：纯视觉进度条
      document.querySelectorAll(".post--music").forEach((post) => {
        const btn = post.querySelector("[data-play]");
        const bar = post.querySelector("[data-bar]");
        const duration = (parseFloat(post.dataset.duration) || 30) * 1000;
        let elapsed = 0, playStart = 0;

        function loop() {
          elapsed = performance.now() - playStart;
          const pct = Math.min(elapsed / duration, 1);
          bar.style.width = pct * 100 + "%";
          if (pct >= 1) { elapsed = 0; bar.style.width = "0%"; post.classList.remove("is-playing", "played"); playing = null; raf = null; return; }
          raf = requestAnimationFrame(loop);
        }
        const ctrl = {
          play() { post.classList.add("is-playing", "played"); playStart = performance.now() - elapsed; raf = requestAnimationFrame(loop); },
          pause() { elapsed = performance.now() - playStart; post.classList.remove("is-playing"); if (raf) cancelAnimationFrame(raf); raf = null; },
        };
        btn.addEventListener("click", () => {
          if (playing === ctrl) { ctrl.pause(); playing = null; }
          else { if (playing) playing.pause(); playing = ctrl; ctrl.play(); }
        });
      });

      // 视频：真实播放，进度条跟随 currentTime
      document.querySelectorAll(".post--video").forEach((post) => {
        const video = post.querySelector("[data-video]");
        const bar = post.querySelector("[data-bar]");
        const media = post.querySelector(".post__media");
        const ctrl = { pause() { video.pause(); post.classList.remove("is-playing"); } };

        video.addEventListener("timeupdate", () => {
          if (video.duration) bar.style.width = (video.currentTime / video.duration) * 100 + "%";
        });
        video.addEventListener("ended", () => {
          post.classList.remove("is-playing", "played"); bar.style.width = "0%";
          if (playing === ctrl) playing = null;
        });
        media.addEventListener("click", () => {
          if (video.paused) {
            if (playing && playing !== ctrl) playing.pause();
            playing = ctrl; post.classList.add("is-playing", "played"); video.play();
          } else {
            video.pause(); post.classList.remove("is-playing"); playing = null;
          }
        });
      });
    </script>
  </body>
</html>