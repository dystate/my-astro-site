---
import "@/styles/global.css";
import BulletinBoard from "@/components/board/BulletinBoard.astro";
import DottedSurface from "@/components/DottedSurface.astro";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dystate</title>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body
    class="bg-[#f0f0f0] min-h-screen antialiased"
    style="font-family:'Courier Prime', monospace;"
  >
    
    <div class="fixed inset-0 z-0 opacity-[0.05] pointer-events-none" 
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;">
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      
      <header class="fixed top-8 left-8 z-50">
        <a
          href="/"
          class="text-3xl font-bold no-underline tracking-[0.15em]"
        >
          <span class="text-blue-600">D</span>y<span class="text-green-500">st</span>ate<span class="text-yellow-500">_</span>
        </a>
      </header>

      <main class="flex-1 flex flex-col w-full">
        
        <section class="relative h-screen flex flex-col items-center justify-center p-10 overflow-hidden border-b-4 border-black">
          
          <!-- 背景：点阵波浪（替代原来的视频） -->
          <DottedSurface dots="dark" />

          <div class="relative z-10 flex flex-col items-center text-center space-y-4">
            
            <div class="relative mb-8 mt-10 sm:mt-0">
              <div class="w-40 h-40 sm:w-48 sm:h-48 bg-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(255,255,255,0.2)] flex items-center justify-center animate-bounce">
                <a href="/menu" >
                  <img
                    src="/avatar.svg"
                  />
                </a>
              </div>
              
              <div class="absolute -top-12 -right-4 sm:-top-10 sm:-right-20 bg-black border-2 border-white text-white px-3 py-1 sm:px-4 sm:py-2 text-sm sm:text-xl rounded-none after:content-[''] after:absolute after:top-full after:left-4 after:border-8 after:border-transparent after:border-t-white shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)]">
                你好，地球人！
              </div>
            </div>

          </div>
        </section>

        <!-- 告示栏 -->
        <section class="px-5 sm:px-10 py-16 sm:py-24 border-b-4 border-black">
          <div class="max-w-5xl mx-auto">
            <BulletinBoard />
          </div>
        </section>
      
      </main>

      <footer class="p-8 sm:p-10 text-center text-slate-400 text-lg sm:text-xl border-t-4 border-black bg-white">
        © 2026 DYSTATE. 
      </footer>

    </div>
  </body>
</html>
