---
import AppMenuBar from "@/components/ui/app-menu-bar";
import LitterPlayground from "@/components/LitterPlayground.astro";
import "@/styles/global.css";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dystate</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#f0f0f0] min-h-screen font-['VT323'] antialiased">
    
    <div class="fixed inset-0 z-0 opacity-[0.05] pointer-events-none" 
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;">
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      
      <header class="sticky top-0 z-50 w-full py-4 sm:py-6 bg-[#f0f0f0]/90 backdrop-blur-md border-b-4 border-black">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-10 flex items-center justify-between">
          <a href="/" class="text-2xl sm:text-4xl font-bold no-underline tracking-widest shrink-0">
            <span class="text-blue-600">D</span>y<span class="text-green-500">st</span>ate<span class="text-yellow-500">_</span>
          </a>
          <nav class="flex-1 flex justify-center">
            <AppMenuBar client:load />
          </nav>
          <div class="hidden sm:flex min-w-[180px] text-right justify-end shrink-0">
             <span class="text-base bg-black text-white border-2 border-black px-3 py-1 font-mono tracking-tight shadow-[4px_4px_0px_0px_rgba(0,0,0,0.15)]">
                793400999@qq.com
             </span>
          </div>
        </div>
      </header>

      <main class="flex-1 flex flex-col w-full">
        
        <section class="relative h-screen flex flex-col items-center justify-center p-10 overflow-hidden border-b-4 border-black">
          
          <div class="absolute inset-0 z-0">
            
            <video autoplay loop muted playsinline class="hidden sm:block w-full h-full object-cover">
              <source src="/videos/backgroundH.mp4" type="video/mp4" />
            </video>

            <video autoplay loop muted playsinline class="block sm:hidden w-full h-full object-cover">
              <source src="/videos/backgroundS.mp4" type="video/mp4" />
            </video>

            </div>

          <div class="relative z-10 flex flex-col items-center">
            
            <div class="relative mb-8 mt-10 sm:mt-0">
              <div class="w-40 h-40 sm:w-48 sm:h-48 bg-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(255,255,255,0.2)] flex items-center justify-center animate-bounce">
                <img src="/avatar.svg" alt="Pixel Avatar" class="w-32 h-32 sm:w-40 sm:h-40" style="image-rendering: pixelated;" />
              </div>
              
              <div class="absolute -top-12 -right-4 sm:-top-10 sm:-right-20 bg-black border-2 border-white text-white px-3 py-1 sm:px-4 sm:py-2 text-sm sm:text-xl rounded-none after:content-[''] after:absolute after:top-full after:left-4 after:border-8 after:border-transparent after:border-t-white shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)]">
                你好，地球人！
              </div>
            </div>

            </div>
          </div>
        </section>

        <section class="max-w-[1200px] mx-auto w-full px-4 sm:px-10 mt-10 pb-20">
           <LitterPlayground />
        </section>
      
      </main>

      <footer class="p-8 sm:p-10 text-center text-slate-400 text-lg sm:text-xl border-t-4 border-black bg-white">
        © 2026 DYSTATE. 
      </footer>

    </div>
  </body>
</html> 
