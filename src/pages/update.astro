---
// src/pages/update.astro
// 网站更新日志：一条 md = 一个版本，按日期倒序排成工单时间线。
// 走 SSR（默认 output: 'server'），与 /logs 一致。
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { getCollection, render } from "astro:content";

const collected = await getCollection("updates", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const entries = await Promise.all(
  collected
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => {
      const { Content } = await render(entry);
      return { id: entry.id, Content, ...entry.data };
    }),
);

const KIND = {
  feature: { label: "FEATURE", color: "#9be014" },
  design: { label: "DESIGN", color: "#facc15" },
  fix: { label: "FIX", color: "#ef4444" },
} as const;

const OPERATOR = { add: "+", change: "~", remove: "−" } as const;

const pad = (n: number) => String(n).padStart(2, "0");
const fmtDate = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

const lastDate = entries.length ? fmtDate(entries[0].date) : "—";
---

<Layout title="Update · Dystate">
  {/* 深色页 → 白色顶栏 + 像素十字全屏菜单 */}
  <header class="upd-header">
    <a class="upd-logo dystate-brand" href="/">Dystate</a>
    <nav class="upd-nav" aria-label="导航">
      <SiteNav current="update" />
    </nav>
    <button class="upd-menu-btn site-menu-label site-menu-corner" id="upd-menu-open" aria-label="打开菜单">
      MENU
      <span class="px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="10" y="0" width="4" height="4" fill="currentColor"/><rect x="10" y="5" width="4" height="4" fill="currentColor"/><rect x="10" y="10" width="4" height="4" fill="currentColor"/><rect x="10" y="15" width="4" height="4" fill="currentColor"/><rect x="10" y="20" width="4" height="4" fill="currentColor"/><rect x="0" y="10" width="4" height="4" fill="currentColor"/><rect x="5" y="10" width="4" height="4" fill="currentColor"/><rect x="15" y="10" width="4" height="4" fill="currentColor"/><rect x="20" y="10" width="4" height="4" fill="currentColor"/>
      </svg></span>
    </button>
  </header>

  <div class="upd-m-menu" id="upd-m-menu" aria-hidden="true">
    <div class="upd-m-top">
      <span class="upd-logo dystate-brand">Dystate</span>
      <button class="upd-m-x site-menu-label site-menu-corner" id="upd-menu-close" aria-label="关闭菜单">CLOSE
        <span class="px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="10" y="0" width="4" height="4" fill="currentColor"/><rect x="10" y="5" width="4" height="4" fill="currentColor"/><rect x="10" y="10" width="4" height="4" fill="currentColor"/><rect x="10" y="15" width="4" height="4" fill="currentColor"/><rect x="10" y="20" width="4" height="4" fill="currentColor"/><rect x="0" y="10" width="4" height="4" fill="currentColor"/><rect x="5" y="10" width="4" height="4" fill="currentColor"/><rect x="15" y="10" width="4" height="4" fill="currentColor"/><rect x="20" y="10" width="4" height="4" fill="currentColor"/>
        </svg></span>
      </button>
    </div>
    <nav>
      <SiteNav current="update" />
    </nav>
  </div>

  <main class="upd-page">
    <div class="upd-lede">
      <h1 class="upd-h1">更新日志</h1>
      <div class="upd-stats">
        {entries.length} ENTRIES<br />LAST {lastDate}
      </div>
    </div>

    {entries.length === 0 ? (
      <p class="upd-empty">还没有记录任何版本。</p>
    ) : (
      <ol class="upd-list">
        {entries.map((entry) => {
          const kind = KIND[entry.kind];
          return (
            <li class="upd-item">
              <div class="upd-rail" aria-hidden="true">
                <span class="upd-node" style={`background:${kind.color}`}></span>
                <span class="upd-stem"></span>
              </div>

              <div class="upd-body">
                <div class="upd-line">
                  <span class="upd-version">{entry.version}</span>
                  <span class="upd-date">{fmtDate(entry.date)}</span>
                  <span class="upd-badge" style={`background:${kind.color}`}>{kind.label}</span>
                </div>

                <h2 class="upd-title">{entry.title}</h2>

                {entry.summary && <p class="upd-summary">{entry.summary}</p>}

                {entry.changes.length > 0 && (
                  <ul class="upd-changes">
                    {entry.changes.map((change) => (
                      <li class={`upd-change upd-change--${change.type}`}>
                        <span class="upd-op">{OPERATOR[change.type]}</span>
                        {change.text}
                      </li>
                    ))}
                  </ul>
                )}

                {entry.Content && (
                  <div class="upd-prose">
                    <entry.Content />
                  </div>
                )}

                {entry.tags.length > 0 && (
                  <div class="upd-tags">
                    {entry.tags.map((tag: string) => <span class="upd-tag">#{tag}</span>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    )}
  </main>

  <script is:inline>
    (function () {
      var o = document.getElementById("upd-menu-open"),
          c = document.getElementById("upd-menu-close"),
          m = document.getElementById("upd-m-menu");
      if (!o || !m) return;
      function open() { m.classList.add("open"); m.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }
      function close() { m.classList.remove("open"); m.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; }
      o.addEventListener("click", open);
      if (c) c.addEventListener("click", close);
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
      m.querySelectorAll("nav a").forEach(function (a) { a.addEventListener("click", close); });
    })();
  </script>
</Layout>

<style is:global>
  body { background: #000; }

  /* ===== 顶栏（与 /logs 同一套：黑色渐变遮罩 + 白色 + 像素十字） ===== */
  .upd-header { position: fixed; top: 0; inset-inline: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 16px; pointer-events: none; background: linear-gradient(to bottom, rgba(0,0,0,.96), rgba(0,0,0,0)); }
  .upd-header > * { pointer-events: auto; }
  .upd-logo { color: #fff; text-decoration: none; }
  .upd-nav { display: none; align-items: center; gap: 32px; }
  .upd-nav a { font: 800 18px/1 "Cal Sans","Open Sans",sans-serif; letter-spacing: .04em; color: #fff; text-decoration: none; padding-bottom: 2px; border-bottom: 2px solid transparent; transition: color .2s, border-color .2s; }
  .upd-nav a:hover, .upd-nav a.active { color: var(--nav-accent, #fff); }
  .upd-nav a.active { border-bottom-color: var(--nav-accent, #fff); }
  .upd-menu-btn { display: flex; align-items: center; gap: 8px; background: none; border: none; cursor: pointer; color: #fff; font: 800 22px/1 "Open Sans",sans-serif; letter-spacing: .04em; }
  @media (min-width: 860px) { .upd-nav { display: flex; } .upd-menu-btn { display: none; } }
  .px { display: inline-flex; }

  /* ===== 移动端全屏菜单 ===== */
  .upd-m-menu { position: fixed; inset: 0; z-index: 70; display: flex; flex-direction: column; background: #000; color: #fff; opacity: 0; pointer-events: none; transition: opacity .3s cubic-bezier(.16,1,.3,1); }
  .upd-m-menu.open { opacity: 1; pointer-events: auto; }
  .upd-m-top { display: flex; align-items: center; justify-content: space-between; padding: 16px; }
  .upd-m-x { display: flex; align-items: center; gap: 8px; background: none; border: none; cursor: pointer; color: #fff; font: 800 22px/1 "Open Sans",sans-serif; letter-spacing: .04em; }
  .upd-m-x .px { transition: transform .3s cubic-bezier(.16,1,.3,1); }
  .upd-m-menu.open .upd-m-x .px { transform: rotate(45deg); }
  .upd-m-menu nav { flex: 1; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; padding: 0 16px; }
  .upd-m-menu nav a { font: 800 64px/.95 "Cal Sans","Open Sans",sans-serif; letter-spacing: -.02em; color: #fff; text-decoration: none; opacity: 0; transform: translateY(24px); transition: color .3s, opacity .5s cubic-bezier(.16,1,.3,1), transform .5s cubic-bezier(.16,1,.3,1); }
  .upd-m-menu nav a:hover, .upd-m-menu nav a.active { color: var(--nav-accent, #fff); }
  .upd-m-menu.open nav a { opacity: 1; transform: none; }
  .upd-m-menu.open nav a:nth-child(1) { transition-delay: .10s; }
  .upd-m-menu.open nav a:nth-child(2) { transition-delay: .18s; }
  .upd-m-menu.open nav a:nth-child(3) { transition-delay: .26s; }

  /* ===== 页面 ===== */
  .upd-page { min-height: 100dvh; background: #000; color: #fff; padding: clamp(96px,14vh,150px) clamp(16px,5vw,64px) clamp(64px,10vh,120px); box-sizing: border-box; max-width: 920px; margin: 0 auto; }

  .upd-lede { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding-bottom: clamp(24px,4vh,40px); border-bottom: 1px solid rgba(255,255,255,.14); }
  .upd-h1 { margin: 0; font: 800 clamp(34px,5vw,52px)/1 "Cal Sans","Open Sans",sans-serif; letter-spacing: -.02em; }
  .upd-stats { flex: none; text-align: right; font: 400 11px/1.5 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; letter-spacing: .08em; color: rgba(255,255,255,.45); }

  /* ===== 时间线 ===== */
  .upd-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .upd-item { display: flex; gap: clamp(12px,2vw,18px); padding: clamp(22px,3.4vh,34px) 0; cursor: default; }
  .upd-rail { flex: none; display: flex; flex-direction: column; align-items: center; padding-top: 7px; }
  .upd-node { width: 9px; height: 9px; flex: none; }
  .upd-stem { flex: 1; margin-top: 6px; border-left: 1px dotted rgba(255,255,255,.28); }
  .upd-item:last-child .upd-stem { border-left-color: transparent; }

  .upd-body { min-width: 0; flex: 1; transition: padding-left .25s cubic-bezier(.16,1,.3,1); }
  .upd-item:hover .upd-body { padding-left: 12px; }

  .upd-line { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .upd-version { font: 400 12px/1 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; letter-spacing: .1em; color: #fff; }
  .upd-date { font: 400 11px/1 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; letter-spacing: .06em; color: rgba(255,255,255,.45); }
  .upd-badge { font: 700 10px/1 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; letter-spacing: .1em; color: #000; padding: 3px 6px; }
  .upd-title { margin: 8px 0 0; font: 800 clamp(21px,2.4vw,28px)/1.2 "Cal Sans","Open Sans",sans-serif; letter-spacing: -.01em; transition: color .2s; }
  .upd-item:hover .upd-title { color: #5451f2; }
  .upd-summary { margin: 8px 0 0; font: 400 13px/1.8 "Cal Sans", "Instrument Serif", serif; color: rgba(255,255,255,.62); }

  /* diff 列表 */
  .upd-changes { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 5px; font: 400 12px/1.6 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; }
  .upd-change { display: flex; gap: 8px; }
  .upd-op { flex: none; width: 1em; }
  .upd-change--add { color: #9be014; }
  .upd-change--change { color: #facc15; }
  .upd-change--remove { color: #ef4444; }

  /* md 正文（可选补充） */
  .upd-prose { margin-top: 12px; color: rgba(255,255,255,.58); font: 400 13px/1.85 "Cal Sans", "Instrument Serif", serif; }
  .upd-prose p { margin: 0 0 .7em; }
  .upd-prose p:last-child { margin-bottom: 0; }
  .upd-prose a { color: #9be014; text-decoration: underline; }
  .upd-prose strong { color: #fff; }
  .upd-prose code { font-family: ui-monospace, monospace; font-size: .92em; background: rgba(255,255,255,.08); padding: 1px 4px; }

  .upd-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
  .upd-tag { font: 400 11px/1 "Cal Sans", "Nokia Cellphone FC Small", ui-monospace, monospace; letter-spacing: .04em; color: #5451f2; }

  .upd-empty { margin: 40px 0 0; font: 400 16px/1.6 "Cal Sans", "Instrument Serif", serif; color: rgba(255,255,255,.6); }

  @media (max-width: 640px) {
    .upd-lede { flex-direction: column; align-items: flex-start; gap: 10px; }
    .upd-stats { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .upd-body, .upd-title, .upd-nav a, .upd-m-menu, .upd-m-menu nav a, .upd-m-x .px { transition: none; }
  }
</style>
