---
// src/pages/life.astro
// 照片墙 · Dystate —— 拍立得风（参考小红书样式）
// 数据来自 src/data/life.ts。若有全局 Layout，可把 <main> 包进去。
import { lifeEntries } from "../data/life";

const PIN: Record<string, string> = {
  pearl:  "#d9d6cf",
  yellow: "#f4c20d",
  green:  "#28a745",
  blue:   "#2d6cff",
  red:    "#ff5c39",
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>LIFE · Dystate</title>
</head>
<body>
    <!-- 返回菜单 Logo -->
    <a href="/menu" aria-label="返回菜单" title="返回菜单"
       style="position:fixed;top:28px;left:50%;transform:translateX(-50%);z-index:1000;
              font:700 28px/1 'Helvetica Neue',Arial,sans-serif;letter-spacing:0.15em;
              text-decoration:none;color:#111;">
      <span style="color:#2563eb">D</span>y<span style="color:#22c55e">st</span>ate<span style="color:#eab308">_</span>
    </a>
  <main class="life">
    <header class="life__head">
      <h1 class="life__title">Life</h1>
      <p class="life__sub">距2026.6已经有{lifeEntries.length}张照片惹</p>
    </header>

    <section class="wall" aria-label="照片墙">
      {lifeEntries.map((p) => (
        <figure
          class="card"
          style={`--rot:${p.rot ?? 0}deg; --pin:${PIN[p.pin ?? "pearl"]};`}
          data-id={p.id}
          data-src={p.src}
          data-alt={p.alt}
          data-date={p.date}
          data-diary={p.diary ?? ""}
          tabindex="0"
          role="button"
          aria-label={`${p.alt}, ${p.date}，点击查看`}
        >
          <span class="card__pin" aria-hidden="true"></span>
          <div class="card__photo">
            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
          </div>
          <figcaption class="card__cap">
            <span class="card__date">{p.date}</span>
          </figcaption>
        </figure>
      ))}
    </section>
  </main>

  {/* ── 灯箱：点卡片弹出大图 + 日记 + 备注 ── */}
  <div class="lb" id="lb" hidden>
    <button class="lb__close" id="lbClose" aria-label="关闭">×</button>
    <figure class="lb__inner">
      <img class="lb__img" id="lbImg" src="" alt="" />
      <figcaption class="lb__meta">
        <p class="lb__date" id="lbDate"></p>
        <p class="lb__diary" id="lbDiary"></p>
        <p class="lb__note" id="lbNote"></p>
      </figcaption>
    </figure>
  </div>
</body>
</html>

<style is:global>
  /* 全局重置：去掉 body 默认白边，整页深底 */
  html, body { margin: 0; padding: 0; background: #1b1b1b; }
  /* 隐藏滚动条但仍可滚动 */
  html { scrollbar-width: none; -ms-overflow-style: none; }
  html::-webkit-scrollbar { width: 0; height: 0; }
</style>

<style>
  .life {
    --bg:      #1b1b1b;   /* 深色底，跟参考图一致 */
    --card:    #ffffff;   /* 拍立得卡纸 */
    --ink:     #2a2a2a;   /* 日期文字 */
    --muted:   #9a978f;   /* EXIF / 次要文字 */

    min-height: 100vh;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 4rem);
    box-sizing: border-box;
    background: var(--bg);
    color: #efeee9;
    font-family: "Helvetica Neue", "Inter", system-ui,
                 "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  /* ── 页头 ── */
  .life__head { margin-bottom: clamp(1.75rem, 4vw, 3rem); }
  .life__title {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .life__sub {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: #8d8a84;
    letter-spacing: 0.04em;
  }

  /* ── 瀑布流（CSS 多列），卡片不被截断 ── */
  .wall {
    column-count: 3;
    column-gap: clamp(0.75rem, 1.4vw, 1.1rem);
  }
  @media (min-width: 1280px) { .wall { column-count: 4; } }
  @media (max-width: 760px)  { .wall { column-count: 2; } }
  @media (max-width: 440px)  { .wall { column-count: 1; } }

  /* ── 拍立得卡片 ── */
  .card {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin: 0 0 clamp(0.75rem, 1.4vw, 1.1rem);
    width: 100%;
    padding: 10px 10px 0;
    background: var(--card);
    border-radius: 2px;
    box-shadow:
      0 1px 1px rgba(0,0,0,.35),
      0 12px 26px rgba(0,0,0,.45);
    transform: rotate(var(--rot));
    transition: transform .22s cubic-bezier(.2,.8,.2,1),
                box-shadow .22s ease;
    cursor: pointer;
    outline: none;
  }
  .card:hover,
  .card:focus-visible {
    transform: rotate(0deg) translateY(-6px) scale(1.015);
    box-shadow:
      0 2px 2px rgba(0,0,0,.35),
      0 22px 40px rgba(0,0,0,.55);
    z-index: 5;
    position: relative;
  }
  .card:focus-visible { box-shadow: 0 0 0 2px #efeee9, 0 22px 40px rgba(0,0,0,.55); }

  /* 圆头图钉：正常流 + 负 margin 顶上去（不用 absolute，避开多列 bug） */
  .card__pin {
    display: block;
    width: 16px;
    height: 16px;
    margin: -20px auto 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 33% 28%,
                  rgba(255,255,255,.95), var(--pin) 55%, rgba(0,0,0,.4));
    box-shadow: 0 3px 5px rgba(0,0,0,.45);
    position: relative;   /* relative 不会触发多列定位 bug */
    z-index: 3;
  }

  .card__photo { line-height: 0; background: #f0efe9; }
  .card__photo img { display: block; width: 100%; height: auto; }

  .card__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 9px 4px 12px;
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }
  .card__date { color: var(--ink); }
  .card__exif { color: var(--muted); flex: none; }

  /* ── 灯箱 ── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(10,10,10,.82);
    backdrop-filter: blur(4px);
    animation: lbIn .18s ease;
  }
  .lb[hidden] { display: none; }
  @keyframes lbIn { from { opacity: 0; } to { opacity: 1; } }

  .lb__close {
    position: absolute;
    top: clamp(.75rem, 2vw, 1.5rem);
    right: clamp(.75rem, 2vw, 1.5rem);
    width: 40px; height: 40px;
    font-size: 1.6rem; line-height: 1;
    color: #efeee9; background: transparent;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;
    cursor: pointer;
    transition: background .15s;
  }
  .lb__close:hover { background: rgba(255,255,255,.12); }

  .lb__inner {
    margin: 0;
    max-width: min(900px, 100%);
    max-height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(220px, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }
  @media (max-width: 700px) {
    .lb__inner { grid-template-columns: 1fr; overflow-y: auto; }
  }

  .lb__img {
    display: block;
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    background: #111;
    box-shadow: 0 20px 50px rgba(0,0,0,.6);
  }
  .lb__meta { color: #e7e5df; }
  .lb__date { margin: 0 0 1rem; font-size: .85rem; color: #b9b6ae; letter-spacing: .03em; }
  .lb__diary { margin: 0 0 1.25rem; font-size: 1rem; line-height: 1.8; white-space: pre-line; }
  .lb__note {
    margin: 0; font-size: .8rem; color: #b9b6ae;
    padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.15);
  }
  .lb__note:empty, .lb__diary:empty { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover, .card:focus-visible { transform: rotate(0deg); }
    .lb { animation: none; }
  }
</style>

<script>
  const lb     = document.getElementById("lb")!;
  const lbImg  = document.getElementById("lbImg") as HTMLImageElement;
  const lbDate = document.getElementById("lbDate")!;
  const lbDiary= document.getElementById("lbDiary")!;
  const lbNote = document.getElementById("lbNote")!;
  const lbClose= document.getElementById("lbClose")!;

  function openCard(el: HTMLElement) {
    lbImg.src   = el.dataset.src ?? "";
    lbImg.alt   = el.dataset.alt ?? "";
    const exif  = el.dataset.exif ? `　·　${el.dataset.exif}` : "";
    lbDate.textContent  = (el.dataset.date ?? "") + exif;
    lbDiary.textContent = el.dataset.diary ?? "";
    lbNote.textContent  = el.dataset.note ? `备注：${el.dataset.note}` : "";
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    lbClose.focus();
  }
  function close() {
    lb.hidden = true;
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
    card.addEventListener("click", () => openCard(card));
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openCard(card); }
    });
  });
  lbClose.addEventListener("click", close);
  lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !lb.hidden) close(); });
</script>