---
import "@/styles/global.css";
import BulletinBoard from "@/components/board/BulletinBoard.astro";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>我 · Dystate</title>
  </head>
  <body
    class="min-h-screen antialiased"
    style="background: #2d2e36; color: #fff;"
  >
    <!-- 顶部 logo -->
    <header style="position: fixed; top: 24px; left: 50%; transform: translateX(-50%); z-index: 50;">
      <a
        href="/menu"
        style="
          color: #fff;
          font: 800 28px/1 system-ui, sans-serif;
          letter-spacing: 0.12em;
          text-decoration: none;
          padding: 8px 20px;
        "
      >
        <span style="color:#60a5fa">D</span>y<span style="color:#4ade80">st</span>ate<span style="color:#facc15">_</span>
      </a>
    </header>

    <main style="max-width: 960px; margin: 0 auto; padding: 120px 20px 80px;">
      <BulletinBoard />
    </main>
  </body>
</html>
