---
import "@/styles/global.css";
import BulletinBoard from "@/components/board/BulletinBoard.astro";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>我 · Dystate</title>
  </head>
  <body
    class="min-h-screen antialiased"
    style="background: #2d2e36; color: #fff;"
  >
    <!-- 顶部 logo -->
    <header style="position: fixed; top: 24px; left: 50%; transform: translateX(-50%); z-index: 50;">
      <a
        href="/menu"
        style="
          color: #fff;
          font: 800 28px/1 system-ui, sans-serif;
          letter-spacing: 0.12em;
          text-decoration: none;
          padding: 8px 20px;
          transition: color 0.15s;
        "
        onmouseenter="this.style.color='#5451f2'"
        onmouseleave="this.style.color='#fff'"
      >
        Dystate_
      </a>
    </header>

    <!-- 主题切换 -->
    <div style="display: flex; justify-content: center; padding-top: 90px; position: relative; z-index: 20;">
      <button
        id="themeToggle"
        style="
          background: #fff;
          color: #000;
          border: 3px solid #000;
          padding: 8px 28px;
          font-size: 13px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          cursor: pointer;
          box-shadow: 4px 4px 0 0 #000;
          transition: all 120ms ease;
        "
        onmouseenter="this.style.boxShadow='2px 2px 0 0 #000'; this.style.transform='translate(2px, 2px)'"
        onmouseleave="this.style.boxShadow='4px 4px 0 0 #000'; this.style.transform='translate(0, 0)'"
      >
        <span id="themeLabel">🌙 暗色</span>
      </button>
    </div>

    <!-- 像素小人 -->
    <div style="display: flex; justify-content: center; padding-top: 28px; position: relative; z-index: 10;">
      <div style="position: relative;">
        <div style="width: 160px; height: 160px; background: #fff; border: 4px solid #000; box-shadow: 8px 8px 0 0 rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; animation: bounce 2s infinite;">
          <a href="/menu">
            <img src="/avatar.svg" alt="像素头像" style="display: block;" />
          </a>
        </div>
        <div style="position: absolute; top: -44px; right: -72px; background: #000; border: 2px solid #fff; color: #fff; padding: 4px 16px; font-size: 18px; white-space: nowrap; box-shadow: 4px 4px 0 0 rgba(255,255,255,0.3);">
          你好，地球人！
          <span style="position: absolute; top: 100%; left: 16px; border: 8px solid transparent; border-top-color: #fff;"></span>
        </div>
      </div>
    </div>
    <style>
      @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }
    </style>

    <main style="max-width: 960px; margin: 0 auto; padding: 40px 20px 80px;">
      <BulletinBoard />
    </main>
    <script>
      const html = document.documentElement;
      const btn = document.getElementById('themeToggle');
      const label = document.getElementById('themeLabel');
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') {
        html.classList.add('dark');
        if (label) label.textContent = '☀️ 亮色';
      }
      if (btn) {
        btn.addEventListener('click', () => {
          const isDark = html.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          if (label) label.textContent = isDark ? '☀️ 亮色' : '🌙 暗色';
        });
      }
    </script>
  </body>
</html>
