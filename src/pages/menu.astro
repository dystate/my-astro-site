---
// src/pages/menu.astro
// 堆叠卡片 — 新粗野主义风格
import StackingCard from "@/components/ui/stacking-card";
import "@/styles/global.css";
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dystate — Menu</title>
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: #e5e5e5;
        font-family: "Helvetica Neue", Arial, sans-serif;
      }
      .dark body { background: #1a1a1a; }
      .hero-dots {
        background-image: radial-gradient(#000 1.5px, transparent 1.5px);
        background-size: 24px 24px;
      }
      .dark .hero-dots {
        background-image: radial-gradient(rgba(255,255,255,0.5) 1.5px, transparent 1.5px);
      }
    </style>
  </head>
  <body>

    <script>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>

    <!-- 堆叠卡片 -->
    <StackingCard client:load projects={[
      {
        title: '我',
        description: '',
        link: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=500&auto=format&fit=crop',
        color: '#5451f2',
        href: '/me',
      },
      {
        title: '生活',
        description: '',
        link: 'https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=500&auto=format&fit=crop',
        color: '#f9ab12',
        href: '/life',
      },
      {
        title: '日志',
        description: '',
        link: 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=500&auto=format&fit=crop',
        color: '#9be014',
        href: '/study',
      },
      {
        title: '永久的春天',
        description: '',
        link: 'https://images.unsplash.com/photo-1465146344425-f00d5f5c8f07?w=500&auto=format&fit=crop',
        color: '#f29fc6',
        href: '/woaidan',
      },
    ]} />

  </body>
</html>
