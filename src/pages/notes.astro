---
import AppMenuBar from "@/components/ui/app-menu-bar";
import "@/styles/global.css";

// 1. 读取所有的 Markdown 日志
let allLogs = [];
try {
  const matches = import.meta.glob('./notes/*.md', { eager: true });
  allLogs = Object.values(matches);
} catch (e) {
  console.warn("未找到日志文件");
}

// 2. 按日期降序排列
const sortedLogs = allLogs.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA; 
});

// 3. 将日志按 category 属性进行分组
const groupedLogs = sortedLogs.reduce((acc, log) => {
  const cat = log.frontmatter.category ? log.frontmatter.category.toUpperCase() : "UNSORTED";
  if (!acc[cat]) {
    acc[cat] = [];
  }
  acc[cat].push(log);
  return acc;
}, {});

// 书脊颜色预设
const spineColors = [
  "bg-white", 
  "bg-blue-100", 
  "bg-pink-100", 
  "bg-yellow-100", 
  "bg-green-100",
  "bg-slate-800 text-white" 
];

// 【核心修复】：日期格式化函数，防止超长字符撑破竖向排版
const formatDate = (rawDate) => {
  if (!rawDate) return "NO DATE";
  try {
    const d = new Date(rawDate);
    // 如果解析出有效日期，则格式化为 YYYY-MM-DD
    if (!isNaN(d.getTime())) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }
    return String(rawDate).substring(0, 10);
  } catch (e) {
    return String(rawDate).substring(0, 10);
  }
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>日志库 - Dystate</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#f0f0f0] min-h-screen font-['VT323'] antialiased">
    
    <div class="fixed inset-0 z-0 opacity-[0.05] pointer-events-none" 
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;">
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      
      <header class="sticky top-0 z-50 w-full py-4 sm:py-6 bg-[#f0f0f0]/90 backdrop-blur-md border-b-4 border-black">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-10 flex items-center justify-between">
          <a href="/" class="text-2xl sm:text-4xl font-bold no-underline tracking-widest shrink-0">
            <span class="text-blue-600">D</span>y<span class="text-green-500">st</span>ate<span class="text-yellow-500">_</span>
          </a>
          <nav class="flex-1 flex justify-center">
            <AppMenuBar client:load />
          </nav>
          <div class="hidden sm:flex min-w-[180px] text-right justify-end shrink-0">
             <span class="text-base bg-black text-white border-2 border-black px-3 py-1 font-mono tracking-tight shadow-[4px_4px_0px_0px_rgba(0,0,0,0.15)]">
                793400999@qq.com
             </span>
          </div>
        </div>
      </header>

      <main class="flex-1 max-w-[1000px] mx-auto w-full p-4 sm:p-10 mt-6 sm:mt-10">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end border-b-4 border-black pb-4 mb-8 sm:mb-16 gap-2">
            <h1 class="text-4xl sm:text-6xl font-bold tracking-tight">ARCHIVE</h1>
            <span class="text-sm sm:text-xl text-slate-500">共收录 {sortedLogs.length} 篇日志</span>
        </div>

        {/* 遍历所有的分类组 */}
        {Object.keys(groupedLogs).length === 0 ? (
            <div class="text-xl sm:text-2xl text-slate-400">书架空空如也...</div>
        ) : (
            Object.entries(groupedLogs).map(([category, logs]) => (
                <div class="mb-16 sm:mb-24">
                    
                    {/* 分类标签牌 */}
                    <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
                        <h2 class="text-xl sm:text-3xl font-bold bg-black text-white px-3 py-1 sm:px-4 sm:py-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.2)] tracking-wider">
                            {category}
                        </h2>
                        <span class="text-slate-400 text-sm sm:text-lg">{logs.length} ITEMS</span>
                    </div>

                    {/* 单层书架容器 */}
                    <div class="flex flex-wrap gap-x-2 sm:gap-x-2 gap-y-8 sm:gap-y-12 items-end justify-start px-2 sm:px-4">
                        {logs.map((log, index) => {
                            const colorClass = spineColors[index % spineColors.length];
                            const isDark = colorClass.includes('bg-slate-800');
                            
                            return (
                                <a 
                                    href={log.url} 
                                    class={`group relative block w-14 sm:w-20 h-[280px] sm:h-[320px] border-[3px] sm:border-4 border-black transition-all duration-300 hover:-translate-y-4 sm:hover:-translate-y-6 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] sm:hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] cursor-pointer ${colorClass}`}
                                >
                                    <div class={`h-3 sm:h-4 border-b-[3px] sm:border-b-4 border-black w-full ${isDark ? 'bg-slate-700' : 'bg-black/10'}`}></div>

                                    <div class="flex flex-col items-center justify-between h-[238px] sm:h-[280px] py-3 sm:py-4">
                                        
                                        <span class="font-bold text-lg sm:text-2xl border-b-2 border-current pb-1">
                                            {String(index + 1).padStart(2, '0')}
                                        </span>

                                        <h3 
                                            class="font-sans font-bold text-[15px] sm:text-lg tracking-widest px-1 sm:px-2 overflow-hidden flex-1 mt-3 text-center leading-relaxed max-h-[140px] sm:max-h-[160px]" 
                                            style="writing-mode: vertical-rl; text-orientation: mixed;"
                                        >
                                            {log.frontmatter.title || "未命名日志"}
                                        </h3>

                                        <span class="text-[10px] sm:text-xs font-mono font-bold uppercase tracking-tighter mt-3 rotate-180 text-center" style="writing-mode: vertical-rl;">
                                            {formatDate(log.frontmatter.date)}
                                        </span>
                                    </div>

                                    <div class={`absolute bottom-0 h-3 sm:h-4 border-t-[3px] sm:border-t-4 border-black w-full ${isDark ? 'bg-slate-700' : 'bg-black/10'}`}></div>
                                </a>
                            );
                        })}
                    </div>

                    {/* 单层书架的底板：手机端厚度变薄 */}
                    <div class="w-full h-3 sm:h-4 bg-black mt-2 shadow-[0_6px_0px_0px_rgba(0,0,0,0.2)] sm:shadow-[0_8px_0px_0px_rgba(0,0,0,0.2)] rounded-sm"></div>
                </div>
            ))
        )}

      </main>
    </div>
  </body>
</html>
