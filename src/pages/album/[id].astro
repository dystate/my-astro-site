---
// src/pages/album/[id].astro
// 点进某个作品后展示的详情页。
// kind === "shelf" → 书架 + 翻书阅读器；默认 → scroll-linked zoom 画廊。
import Layout from "../../layouts/Layout.astro";
import ScrollZoomGallery from "../../components/album/ScrollZoomGallery";
import Bookshelf from "../../components/book/Bookshelf.astro";
import { ALBUM_ITEMS } from "../../data/album";

// server 输出模式下需显式预渲染，getStaticPaths 才会生效（否则 item 为空）
export const prerender = true;

export function getStaticPaths() {
  return ALBUM_ITEMS.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const photos = item.photos ?? [];
const title = item.kind === "shelf" ? "Dystate · 书架" : `${item.title} · Dystate`;
---

<Layout title={title}>
  {item.kind === "shelf" ? (
    <Bookshelf />
  ) : (
    <ScrollZoomGallery client:load albumTitle={item.title} photos={photos} />
  )}
</Layout>
