---
import FlipBook from "../components/FlipBook.astro";

// 每一项 = 一“页”。第一页封面、最后一页封底自动设为硬壳。
// 把 image 换成你自己的漫画扫描图即可（放 public/ 下，写 "/comics/xxx.jpg"）。
const pages = [
  { type: "cover", label: "TEN YEARS AWAY" },                          // 封面
  { year: "YEAR 0", subtitle: "L'INIZIO",     date: "2015" },          // 内页 1
  { year: "YEAR 1", subtitle: "NEW ENTRIES",  date: "2016" },          // 内页 2
  { year: "YEAR 2", subtitle: "GROWTH",       date: "2017" },
  { year: "YEAR 3", subtitle: "NEW SPACE",    date: "2018" },
  { year: "YEAR 4", subtitle: "EXPANSION",    date: "2019" },
  { year: "YEAR 5", subtitle: "PANDEMIC",     date: "2020" },
  { year: "YEAR 6", subtitle: "REMOTE",       date: "2021" },
  { year: "YEAR 7", subtitle: "AWARDS",       date: "2022" },
  { year: "YEAR 8", subtitle: "NEW BRAND",    date: "2023" },
  { type: "cover", label: "THE END" },                                 // 封底
];
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ten Years Away — FlipBook</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        background: #ffffff;
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    <FlipBook
      pages={pages}
      ratio={1.41}
      pageWidth={460}
      dragHint="trascina per girare le pagine"
      credit="375.studio"
    />
  </body>
</html>
