---
// src/pages/study.astro
// 日志存档界面：NoiseField 头部 + 搜索 + 类别筛选 + 可点击日志卡。

import NoiseField from "../components/ui/NoiseField.astro";
import BracketPanel from "../components/ui/BracketPanel.astro";

// 读取 data/study 下所有 markdown 日志
const postModules = import.meta.glob("../data/study/**/*.md");

const logs: { slug: string; title: string; category: string; date: string; tags: string[]; body: string }[] = [];

for (const [path, loader] of Object.entries(postModules)) {
  const mod = await loader() as any;
  const filename = path.split("/").pop()!.replace(".md", "");
  logs.push({
    slug: filename,
    title: mod.frontmatter.title as string,
    category: mod.frontmatter.category as string,
    date: mod.frontmatter.date as string,
    tags: (mod.frontmatter.tags ?? []) as string[],
    body: mod.frontmatter.subtitle || "",
  });
}

// 收集所有类别
const categories = [...new Set(logs.map((l) => l.category))].sort();

// 给每条日志拼一段可搜索文本（标题 + 类别 + 标签 + 日期 + slug），小写化便于匹配
const toText = (l: (typeof logs)[number]) =>
  [l.title, l.category, (l.tags ?? []).join(" "), l.date, l.slug].join(" ").toLowerCase();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>STUDY · 日志存档</title>
  </head>
  <body>
    <main class="study">
      {/* 头部：噪声场 + 标题面板 */}
      <NoiseField seed={7} class="study__hero">
        <div class="study__heroinner">
          <BracketPanel label="ARCHIVE">
            <p class="study__title">STUDY</p>
            <p class="study__sub">日志存档 · 共 {logs.length} 篇</p>
          </BracketPanel>
        </div>
      </NoiseField>

      {/* 搜索 + 计数 */}
      <div class="study__controls">
        <label class="search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" /></svg>
          <input id="study-search" type="search" placeholder="搜索标题、内容、标签…" autocomplete="off" />
        </label>
        <span class="study__count"><b id="study-count">{logs.length}</b> 条结果</span>
      </div>

      {/* 类别 */}
      <div class="study__cats" id="study-cats">
        <button class="cat is-active" data-cat="all" type="button">全部</button>
        {categories.map((c) => (
          <button class="cat" data-cat={c} type="button">{c}</button>
        ))}
      </div>

      {/* 日志流 */}
      <div class="study__list" id="study-list">
        {logs.map((l) => (
          <a href={`/study/${l.slug}`} class="log-link" data-cat={l.category} data-text={toText(l)}>
            <article class="log">
              <BracketPanel label={l.category}>
                <div class="log__meta">
                  <time class="log__date">{l.date}</time>
                  {l.tags && l.tags.length > 0 && (
                    <span class="log__tags">{l.tags.map((t) => `#${t}`).join("  ")}</span>
                  )}
                </div>
                <h3 class="log__title">{l.title}</h3>
                <p class="log__body">{l.body}</p>
              </BracketPanel>
            </article>
          </a>
        ))}
      </div>

      <div class="study__empty" id="study-empty" hidden>没有匹配的日志。</div>
    </main>

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(rgba(0,0,0,.04) 1px, transparent 1px) 0 0 / 22px 22px, #e9e7e0;
        color: #1b1b1b;
        font-family: "Frutiger", "Segoe UI", "Helvetica Neue", "PingFang SC", system-ui, sans-serif;
      }
      .study { max-width: 920px; margin: 0 auto; padding: 40px 24px 96px; }

      /* 头部 */
      .study__hero { min-height: 190px; display: grid; place-items: center; padding: 44px 24px; margin-bottom: 40px; }
      .study__heroinner :global(.bp__body) { padding: 22px 30px; text-align: center; }
      .study__title { margin: 0; font-size: 34px; font-weight: 700; letter-spacing: .14em; }
      .study__sub { margin: 6px 0 0; font-size: 13px; color: #6f6f6f; letter-spacing: .04em; }

      /* 搜索 + 计数 */
      .study__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-bottom: 14px; }
      .study .search { display: flex; align-items: center; gap: 8px; flex: 1 1 260px; min-width: 220px; background: #f4f3ee; border: 1px solid #1b1b1b; box-shadow: 4px 4px 0 0 #141414; padding: 9px 14px; }
      .study .search:focus-within { box-shadow: 4px 4px 0 0 #d81e8f; }
      .study .search svg { color: #6f6f6f; flex: none; }
      .study .search input { border: none; outline: none; background: transparent; font: inherit; font-size: 15px; color: #1b1b1b; width: 100%; }
      .study .search input::placeholder { color: #a7a49a; }
      .study__count { font-size: 12px; color: #6f6f6f; letter-spacing: .08em; white-space: nowrap; }

      /* 类别 */
      .study__cats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 34px; }
      .study .cat { font: inherit; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; padding: 6px 12px; background: #f4f3ee; color: #1b1b1b; border: 1px solid #1b1b1b; }
      .study .cat:hover { background: #ecebe4; }
      .study .cat.is-active { background: #1b1b1b; color: #f4f3ee; }

      /* 日志卡片链接 */
      .study .log-link { display: block; text-decoration: none; color: inherit; }
      .study .log-link:hover .log {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 0 #141414;
      }

      /* 日志流 */
      .study__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 44px 30px; padding-top: 18px; }
      .study .log {
        border: 1px solid #1b1b1b;
        box-shadow: 4px 4px 0 0 #141414;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
      }
      .log__meta { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; }
      .log__date { color: #6f6f6f; letter-spacing: .04em; }
      .log__tags { color: #d81e8f; }
      .log__title { margin: 0 0 8px; font-size: 18px; font-weight: 700; line-height: 1.35; }
      .log__body { margin: 0; font-size: 14px; line-height: 1.65; color: #5e5c55; }

      .study__empty { text-align: center; color: #6f6f6f; padding: 40px 0; font-size: 14px; }

      @media (max-width: 600px) {
        .study__list { grid-template-columns: 1fr; gap: 40px; }
      }
    </style>

    <script>
      const search = document.getElementById("study-search");
      const cats = document.getElementById("study-cats");
      const items = [...document.querySelectorAll(".log-link")];
      const countEl = document.getElementById("study-count");
      const empty = document.getElementById("study-empty");
      let q = "", cat = "all";

      function apply() {
        let n = 0;
        items.forEach((el) => {
          const okCat = cat === "all" || el.dataset.cat === cat;
          const okQ = !q || el.dataset.text.includes(q);
          const show = okCat && okQ;
          el.hidden = !show;
          if (show) n++;
        });
        countEl.textContent = String(n);
        empty.hidden = n !== 0;
      }
      search.addEventListener("input", (e) => { q = e.target.value.trim().toLowerCase(); apply(); });
      cats.addEventListener("click", (e) => {
        const btn = e.target.closest(".cat");
        if (!btn) return;
        cat = btn.dataset.cat;
        cats.querySelectorAll(".cat").forEach((b) => b.classList.toggle("is-active", b === btn));
        apply();
      });
    </script>
  </body>
</html>
