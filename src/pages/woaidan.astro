// src/pages/woaidan.astro

import "../styles/global.css";

import AnimatedLogin from "../components/ui/animated-login";

import { getCollection, render } from 'astro:content';



/* ========== 1. 身份验证 ========== */

const session = Astro.cookies.get("user_session")?.value;

const isLoggedIn = !!session;



/* ========== 2. 读取所有 md，并按「书」分组 ========== */

let booksData = [];

if (isLoggedIn) {

  const entries = await getCollection('woaidan');



  const rendered = await Promise.all(

    entries.map(async (entry) => {

      const { Content } = await render(entry);

      const parts = entry.id.split('/');

      const folder = parts.length > 1 ? parts.slice(0, -1).join('/') : null;

      return {

        bookName: entry.data.book ?? folder ?? '未分组',

        bookOrder: entry.data.bookOrder ?? null,

        pageNumber: entry.data.pageNumber ?? null,

        cover: entry.data.cover ?? null,

        sortKey: entry.id,

        title: entry.data.title ?? '',

        Content,

      };

    })

  );



  const map = new Map();

  for (const r of rendered) {

    if (!map.has(r.bookName)) map.set(r.bookName, { name: r.bookName, order: null, cover: null, pages: [] });

    const b = map.get(r.bookName);

    if (r.bookOrder != null && b.order == null) b.order = r.bookOrder;

    if (r.cover && !b.cover) b.cover = r.cover;

    b.pages.push(r);

  }

  booksData = Array.from(map.values());

  booksData.forEach((b) =>

    b.pages.sort((x, y) => {

      if (x.pageNumber != null && y.pageNumber != null) return x.pageNumber - y.pageNumber;

      return x.sortKey.localeCompare(y.sortKey);

    })

  );

  booksData.sort((a, b) => (a.order ?? 9999) - (b.order ?? 9999) || a.name.localeCompare(b.name));

  booksData.forEach((b, i) => (b.id = i));

}



/* ========== 3. 书架配色与分层（VHS 磁带风 / 暗色） ========== */

const spineColors = [

  "#7a2630", "#9bb0c4", "#d8d2c4", "#262220", "#7a5a38",

  "#33302c", "#1a1818", "#5e5246", "#2a2622", "#cfcabc", "#d4cfc2",

];

const widthSet  = [26, 30, 28, 24, 30, 22, 28, 26, 24, 30, 28];

const heightSet = [92, 98, 95, 100, 94, 96, 99, 93, 97, 95, 91];

// 按相对亮度决定书脊文字颜色：浅色壳用深墨，深色壳用暖白

function inkFor(hex) {

  const r = parseInt(hex.slice(1, 3), 16);

  const g = parseInt(hex.slice(3, 5), 16);

  const b = parseInt(hex.slice(5, 7), 16);

  const lum = 0.299 * r + 0.587 * g + 0.114 * b;

  return lum > 150 ? "#2c2620" : "rgba(243,234,217,0.92)";

}

function bookVisual(idx, name) {

  const seed = idx * 7 + (name?.length || 0);

  const color = spineColors[seed % spineColors.length];

  return {

    color,

    ink: inkFor(color),

    w: widthSet[(idx * 3) % widthSet.length],

    h: heightSet[(idx * 5) % heightSet.length],

  };

}

const total = booksData.length;

// 全部书放在同一层（一层书架）

const shelves = [booksData];

---



<html lang="zh-CN">

<head>

  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <title>Dystate</title>



  <style is:global>

    :root { --bg: #11141a; --shelf-wood: #15110c; --shelf-edge: #2a2118; --teal:#6fb6c9; --orange:#e0552b; }

    html, body { margin: 0; padding: 0; }

    body { background: #ffffff; color: #1c2026; overflow: hidden; }



    /* ---------- 书柜 ---------- */

    .bookcase {

      height: 100vh; height: 100dvh; width: 100vw; position: relative;

      overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch;

      display: flex; flex-direction: column; justify-content: center; gap: clamp(10px, 3.2vh, 26px);

      padding: max(28px, env(safe-area-inset-top)) 0 max(28px, env(safe-area-inset-bottom)); box-sizing: border-box;

      background-color:#ffffff;

      background-image:

        radial-gradient(circle, rgba(0,0,0,.05) 1px, transparent 1.4px);

      background-size: 16px 16px;

      background-attachment: fixed;

    }

    /* 背景正中央水印 */

    .bg-mark { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 0; pointer-events: none; user-select: none; white-space: nowrap; font: 800 clamp(56px, 17vw, 190px)/1 "Arial Black","Noto Sans SC",sans-serif; letter-spacing: -2px; color: rgba(28,32,38,.07); }

    .shelf { width: min(94vw, 760px); margin: 0 auto; display: flex; flex-direction: column; position: relative; z-index: 1; }

    .books { display: flex; align-items: flex-end; justify-content: center; gap: 5px; min-height: clamp(120px, 22vh, 190px); padding: 0 6px; overflow-x: auto; overflow-y: visible; scrollbar-width: none; }

    .books::-webkit-scrollbar { display: none; }

    .board { height: 14px; border-radius: 0 0 3px 3px; background: #3a2c1d; border-top: 1.5px solid #5a452d; box-shadow: 0 -5px 0 rgba(255,255,255,.05) inset, 0 12px 22px -8px rgba(0,0,0,0.7); }

    .book {

      flex: 0 0 auto; width: var(--w); height: var(--h); max-height: clamp(120px, 22vh, 190px);

      position: relative; border: none; padding: 9px 0 7px; cursor: pointer; color: var(--ink); border-radius: 2px 2px 0 0;

      background: var(--c);

      box-shadow: 0 0 0 1px rgba(0,0,0,0.3) inset, 2px 8px 14px -6px rgba(0,0,0,0.8);

      -webkit-box-reflect: below 1px linear-gradient(transparent, transparent 76%, rgba(0,0,0,0.25));

      transition: transform .28s cubic-bezier(.2,.8,.25,1), box-shadow .28s;

      display: flex; flex-direction: column; align-items: center; justify-content: space-between; transform-origin: bottom center;

    }

    .book::after { content:""; position:absolute; top:0; bottom:0; left:0; width:3px; background:rgba(255,255,255,0.14); }

    .book::before { content:""; position:absolute; top:0; bottom:0; right:0; width:5px; background:rgba(0,0,0,0.3); }

    .book.pulling { z-index: 3; }

    .spine-num { font: 700 10px/1 ui-monospace,"SFMono-Regular",monospace; letter-spacing: .5px; padding: 1px 4px; border-radius: 2px; border: 1px solid currentColor; opacity: .82; color: inherit; pointer-events: none; }

    .spine-title { writing-mode: vertical-rl; text-orientation: mixed; font: 500 13px/1.1 "Noto Serif SC","Songti SC",serif; letter-spacing: 3px; white-space: nowrap; overflow: hidden; flex: 1; display: flex; align-items: center; margin: 6px 0; color: inherit; text-shadow: 0 1px 1px rgba(0,0,0,.35); pointer-events: none; }

    .spine-tag { font: 600 8px/1 ui-monospace,"SFMono-Regular",monospace; letter-spacing: .3px; opacity: .72; color: inherit; pointer-events: none; }

    .hint { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); font: 700 11px/1 system-ui, sans-serif; letter-spacing: 3px; text-transform: uppercase; color: #8a8f98; pointer-events: none; z-index: 4; }



    /* 四角线框装饰（海报感） */

    .poster-corners { position: fixed; inset: 16px; pointer-events: none; z-index: 6; }

    .poster-corners.in-stage { position: absolute; inset: 16px; }

    .poster-corners i { position: absolute; width: 26px; height: 26px; border: 1.5px solid rgba(0,0,0,.18); }

    .poster-corners i.tl { top:0; left:0; border-right:0; border-bottom:0; }

    .poster-corners i.tr { top:0; right:0; border-left:0; border-bottom:0; }

    .poster-corners i.bl { bottom:0; left:0; border-right:0; border-top:0; }

    .poster-corners i.br { bottom:0; right:0; border-left:0; border-top:0; }



    /* 顶部居中三格 toolbar */

    .shelf-toolbar {

      position: fixed; top: max(14px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%);

      z-index: 7; display: flex; background: #fff; border-radius: 14px; overflow: hidden;

      border: 1px solid rgba(0,0,0,.06); box-shadow: 0 6px 18px -6px rgba(0,0,0,.28);

    }

    .shelf-toolbar a, .shelf-toolbar .tb-cell {

      width: 56px; height: 48px; display: flex; align-items: center; justify-content: center;

      cursor: pointer; color: #2d3748; text-decoration: none; transition: background .15s;

    }

    .shelf-toolbar a:hover { background: rgba(0,0,0,.05); }

    .shelf-toolbar > * + * { border-left: 1px solid rgba(0,0,0,.08); }

    .shelf-toolbar svg { width: 24px; height: 24px; display: block; }

    .shelf-toolbar .tb-dot { width: 6px; height: 6px; border-radius: 50%; background: #cfd3da; }

    @media (max-width: 760px) {

      .shelf-toolbar a, .shelf-toolbar .tb-cell { width: 50px; height: 44px; }

    }



    /* ---------- 书本阅读器（StPageFlip，效果同 Ten 页） ---------- */

    .reader { position: fixed; inset: 0; z-index: 40; opacity: 0; pointer-events: none; transition: opacity .4s ease;

      display: flex; flex-direction: column;

      background-color:#ffffff;

      background-image: radial-gradient(circle, rgba(0,0,0,.05) 1px, transparent 1.4px);

      background-size: 16px 16px; }

    .reader.show { opacity: 1; pointer-events: auto; }



    /* 顶栏 */

    /* 悬浮叉（左上角，回到书脊界面） */

    .bv-x { position:absolute; top: max(14px, env(safe-area-inset-top)); left: 14px; z-index:20;

      width:40px; height:40px; padding:0; display:flex; align-items:center; justify-content:center;

      border:none; border-radius:999px; cursor:pointer; color:#1c2026;

      background:rgba(255,255,255,.78); backdrop-filter:blur(6px);

      box-shadow:0 6px 18px -6px rgba(0,0,0,.3); transition:transform .15s, background .15s; }

    .bv-x:hover { background:#fff; transform:scale(1.06); }

    .bv-x svg { width:20px; height:20px; display:block; }

    /* 悬浮页码（右上角，与叉对称） */

    .bv-counter { position:absolute; top: max(16px, env(safe-area-inset-top)); right: 16px; z-index:20;

      font:600 13px/1 system-ui,sans-serif; color:#6b7079; pointer-events:none; }



    /* 舞台 */

    .flip-stage { position:relative; flex:1 1 auto; min-height:0; display:flex; align-items:center; justify-content:center; padding: calc(env(safe-area-inset-top, 0px) + 48px) 8px 8px; }

    .flipbook { filter: drop-shadow(0 26px 40px rgba(0,0,0,.32)); -webkit-user-select:none; user-select:none; touch-action: pan-y; }



    /* 轻微整体晃动（褶皱位移已移除），翻页时暂停让卷曲动画干净 */

    .flip-wind {

      --sway-rot: 0.55deg;     /* 晃动幅度 */

      --sway-shift: 3px;

      flex: 0 0 auto;

      display: flex; align-items: center; justify-content: center;

      animation: bookSway 6.5s ease-in-out infinite;

      transform-origin: 50% 46%;

      will-change: transform;

    }

    /* 翻页中：暂停晃动 */

    .flip-wind.is-flipping { animation-play-state: paused; }



    @keyframes bookSway {

      0%   { transform: rotate(calc(var(--sway-rot) * -1)) translateY(0); }

      50%  { transform: rotate(var(--sway-rot)) translateY(calc(var(--sway-shift) * -1)); }

      100% { transform: rotate(calc(var(--sway-rot) * -1)) translateY(0); }

    }



    /* StPageFlip 必需基础样式（内联，免单独 import css） */

    .stf__parent { position:relative; display:block; box-sizing:border-box; transform: translateZ(0); -ms-touch-action: pan-y; touch-action: pan-y; margin:0 auto; }

    .stf__parent canvas { position:absolute; width:100%; height:100%; left:0; top:0; }

    .stf__block { position:absolute; width:100%; height:100%; box-sizing:border-box; perspective:2000px; }

    .stf__item { display:none; position:absolute; transform-style:preserve-3d; }

    .stf__outerShadow,.stf__innerShadow,.stf__hardShadow,.stf__hardInnerShadow { position:absolute; left:0; top:0; }



    /* 单页 */

    .page { background:#fdfbf6; overflow:hidden; }

    .page-content { width:100%; height:100%; position:relative; box-sizing:border-box; padding: 0; overflow:hidden; scrollbar-width:none; }

    .page-content::-webkit-scrollbar { display:none; }

    .page-content.is-cover { padding:0; }



    /* 硬壳封面 / 封底 */

    .cover-art { width:100%; height:100%; border-radius:6px;

      background: linear-gradient(140deg, rgba(255,255,255,.14), rgba(255,255,255,0) 42%), linear-gradient(rgba(0,0,0,.32), rgba(0,0,0,.42)), var(--cover-c,#2f4858);

      display:flex; align-items:center; justify-content:center; padding:22px; box-sizing:border-box; position:relative; }

    .cover-art::after { content:""; position:absolute; inset:12px; border-radius:4px; border:1px solid rgba(111,182,201,.5); }

    .cover-art::before { content:""; position:absolute; top:14px; right:14px; width:14px; height:14px; background:var(--orange); border-radius:2px; z-index:2; }

    .cover-art.has-image { background-size:cover; background-position:center; padding:0; }

    .cover-art.has-image::after, .cover-art.has-image::before { display:none; }

    .cover-art.has-image .cover-title { display:none; }

    .cover-title { font:700 clamp(16px,5vw,26px)/1.3 "Noto Serif SC","Songti SC",serif; color:rgba(255,255,255,.94); text-align:center; text-shadow:0 2px 6px rgba(0,0,0,.5); z-index:1; word-break:break-word; padding:0 14px; }

    .cover-art.cover-back { background: linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.6)), var(--cover-c,#2f4858); }

    .cover-art.cover-back::before { display:none; }

    .cover-art.cover-back .cover-title { font-size: clamp(13px,3.4vw,18px); letter-spacing:3px; opacity:.85; }



    /* 页面类型（沿用原逻辑，作用到 .page-content） */

    .page-content.type-image { padding:0; display:flex; align-items:center; justify-content:center; }

    .page-content.type-image img { width:100%; height:100%; object-fit:contain; display:block; margin:0; }

    .page-content.type-media { display:flex; align-items:center; justify-content:center; padding: clamp(10px,2vw,22px); }

    .page-content.type-media video, .page-content.type-media audio, .page-content.type-media iframe { max-width:100%; max-height:100%; display:block; border-radius:6px; }

    .page-content.type-text { padding: clamp(22px,3.5vw,48px); overflow-y:auto; }

    .page-content.type-text img { display:block; margin:10px auto; max-width:100%; max-height:55%; height:auto; object-fit:contain; border-radius:4px; }

    .page-content h1, .page-content h2 { font-family:"Noto Serif SC",serif; line-height:1.3; margin:.2em 0 .5em; }

    .page-content p { line-height:1.7; margin:0 0 .8em; font-size:15px; }

    .bv-leaf-title { font:700 14px/1.4 "Noto Serif SC",serif; color:#3a342a; margin:0 0 10px; padding-bottom:6px; border-bottom:1px solid #e6e0d4; }



    /* ===== 自定义音乐播放器（白色胶囊，核心功能） ===== */

    .aplayer { display:flex; align-items:center; gap:14px; width:min(94%,460px); padding:11px 18px; background:#fff; border-radius:999px; box-shadow:0 12px 30px -10px rgba(0,0,0,.28); }

    .aplayer audio { display:none; }

    .ap-btn { flex:0 0 auto; width:24px; height:24px; padding:0; border:none; background:transparent; color:#1c2026; cursor:pointer; }

    .ap-btn svg { width:100%; height:100%; display:block; }

    .ap-time { flex:0 0 auto; font:600 13px/1 ui-monospace,"SFMono-Regular",monospace; color:#3a3f49; white-space:nowrap; }

    .ap-seek, .vp-seek { -webkit-appearance:none; appearance:none; height:4px; border-radius:99px; cursor:pointer; outline:none; }

    .ap-seek { flex:1; background:#e2e0da; }

    .ap-seek::-webkit-slider-thumb, .vp-seek::-webkit-slider-thumb { -webkit-appearance:none; width:13px; height:13px; border-radius:50%; background:#1c2026; cursor:pointer; }

    .ap-seek::-moz-range-thumb { width:13px; height:13px; border-radius:50%; background:#1c2026; border:none; cursor:pointer; }



    /* ===== 自定义视频播放器（核心功能） ===== */

    .vplayer { position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#000; border-radius:6px; overflow:hidden; }

    .vplayer video { width:100%; height:100%; object-fit:contain; display:block; background:#000; }

    .vp-center { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; cursor:pointer; }

    .vp-bigplay { width:60px; height:60px; border-radius:50%; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; transition:opacity .2s, transform .2s; }

    .vp-bigplay svg { width:30px; height:30px; }

    .vplayer.playing .vp-bigplay { opacity:0; }

    .vplayer.playing:hover .vp-bigplay { opacity:1; }

    .vp-bar { position:absolute; left:0; right:0; bottom:0; display:flex; align-items:center; gap:10px; padding:18px 12px 9px; background:linear-gradient(0deg, rgba(0,0,0,.65), transparent); }

    .vp-btn { flex:0 0 auto; width:22px; height:22px; padding:0; border:none; background:transparent; color:#fff; cursor:pointer; }

    .vp-btn svg { width:100%; height:100%; display:block; }

    .vp-time { flex:0 0 auto; color:#fff; font:600 12px/1 ui-monospace,monospace; white-space:nowrap; }

    .vp-seek { flex:1; background:rgba(255,255,255,.3); }

    .vp-seek::-webkit-slider-thumb { background:#fff; }

    .vp-seek::-moz-range-thumb { width:13px; height:13px; border-radius:50%; background:#fff; border:none; }



    /* 底栏（同 Ten：左“拖动翻页” 右署名） */

    .bv-bottom { flex:0 0 auto; display:flex; align-items:center; justify-content:space-between; gap:14px; width:min(92vw,920px); margin:0 auto; padding: 8px 4px max(16px, env(safe-area-inset-bottom)); border-top:1px solid rgba(0,0,0,.12); }

    .bv-drag-hint { font: italic 600 clamp(15px,3.2vw,22px)/1 Georgia, serif; color:#111; }

    .bv-credit { font:800 clamp(14px,2.6vw,18px)/1 system-ui,sans-serif; color:#111; }



    /* ---------- 手机端 ---------- */

    @media (max-width: 760px) {

      /* 书架（原样保留） */

      .bookcase { gap: clamp(8px, 2.4vh, 18px); }

      .shelf { width: 96vw; }

      .books { gap: 2px; min-height: clamp(110px, 20vh, 160px); }

      .book { max-height: clamp(110px, 20vh, 160px); }

      .poster-corners, .poster-corners.in-stage { inset: 10px; }

      .poster-corners i { width: 18px; height: 18px; }

    }



    /* 减少动画偏好 */

    @media (prefers-reduced-motion: reduce) {

      .book { transition: none; }

      .flip-wind { animation: none; }

    }

  </style>

</head>



<body class="select-none">

  {isLoggedIn ? (

    <main>

      {/* 书柜 */}

      <div class="bookcase">

        <div class="bg-mark" aria-hidden="true">2026起</div>

        {shelves.map((shelf) => (

          <div class="shelf">

            <div class="books">

              {shelf.map((book) => {

                const v = bookVisual(book.id, book.name);

                return (

                  <button class="book" data-book-id={book.id} data-name={book.name} data-color={v.color} data-pages={book.pages.length} data-cover={book.cover || ''} style={`--c:${v.color}; --ink:${v.ink}; --w:${v.w}px; --h:${v.h}%;`} aria-label={`打开 ${book.name}`}>

                    <span class="spine-num">{String(book.id + 1).padStart(2, '0')}</span>

                    <span class="spine-title">{book.name}</span>

                    <span class="spine-tag">no.{book.id + 1}</span>

                  </button>

                );

              })}

            </div>

            <div class="board"></div>

          </div>

        ))}

      </div>

      <div class="hint">轻触书脊抽出</div>

      <nav class="shelf-toolbar" aria-label="导航">

        <span class="tb-cell" aria-hidden="true"><i class="tb-dot"></i></span>

        <a href="/xzds" aria-label="待办清单"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 6.5l1.4 1.4 2.6-2.6"/><path d="M3.5 12.5l1.4 1.4 2.6-2.6"/><path d="M3.5 18.5l1.4 1.4 2.6-2.6"/><line x1="11" y1="6" x2="20" y2="6"/><line x1="11" y1="12" x2="20" y2="12"/><line x1="11" y1="18" x2="20" y2="18"/></svg></a>

        <span class="tb-cell" aria-hidden="true"><i class="tb-dot"></i></span>

      </nav>

      <div class="poster-corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>



      {/* 封面 + 翻页阅读器（StPageFlip） */}

      <div id="reader" class="reader" aria-hidden="true">

        <button id="close-reader" class="bv-x" aria-label="合上，回到书架">

          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>

        </button>

        <div class="bv-counter"><span id="bv-cur">封面</span> / <span id="bv-total">1</span></div>

        <div class="flip-stage">

          <div id="flip-wind" class="flip-wind">

            <div id="flipbook" class="flipbook"></div>

          </div>

        </div>

        <div class="bv-bottom">

          <span class="bv-drag-hint">drag to turn</span>

          <span class="bv-credit">Dystate</span>

        </div>

      </div>



      {/* 服务端预渲染缓存 */}

      <div id="markdown-server-cache" style="display:none">

        {booksData.map((book) =>

          book.pages.map((pg, pi) => {

            const C = pg.Content;

            return (<div id={`md-${book.id}-${pi}`} data-title={pg.title}><C /></div>);

          })

        )}

      </div>

    </main>

  ) : (

    <AnimatedLogin client:only="react" />

  )}



  {isLoggedIn && (

    <script>

      import { PageFlip } from 'page-flip';



      const books = Array.from(document.querySelectorAll('.book'));

      const reader = document.getElementById('reader');

      let flipRoot = document.getElementById('flipbook');

      const windEl = document.getElementById('flip-wind');

      const curEl = document.getElementById('bv-cur');

      const totEl = document.getElementById('bv-total');



      let activeBook = null, activeId = 0, total = 1, pageFlip = null;

      const isMobile = () => window.matchMedia('(max-width: 760px)').matches;



      function cache(i) { return document.getElementById('md-' + activeId + '-' + i); }

      // 判断页面类型：media(视频/音频) / image(纯图) / text(文字或图文)

      function pageType(html) {

        const d = document.createElement('div'); d.innerHTML = html;

        if (d.querySelector('video, audio, iframe')) return 'media';

        const imgs = d.querySelectorAll('img');

        const text = d.textContent.replace(/\s+/g, '');

        if (imgs.length >= 1 && text === '') return 'image';

        return 'text';

      }

      // 把第 i 页渲染进元素 el，并打上类型 class

      function setPage(el, i) {

        el.classList.remove('type-image', 'type-media', 'type-text');

        const c = cache(i);

        if (!c) { el.innerHTML = ''; return; }

        const raw = c.innerHTML;

        const t = pageType(raw);

        if (t === 'image') { el.innerHTML = raw; el.classList.add('type-image'); }

        else if (t === 'media') { el.innerHTML = raw; el.classList.add('type-media'); }

        else {

          const title = c.getAttribute('data-title');

          el.innerHTML = (title ? '<p class="bv-leaf-title">' + title + '</p>' : '') + raw;

          el.classList.add('type-text');

        }

        el.scrollTop = 0;

      }

      function pageTitle(i) { const c = cache(i); return c ? (c.getAttribute('data-title') || '') : ''; }



      /* ===== 自定义播放器 ===== */

      const I_PLAY  = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';

      const I_PAUSE = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>';

      const I_VOL   = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 4V5L7 9z"/><path d="M15.5 8.5a5 5 0 010 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

      const I_MUTE  = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 4V5L7 9z"/><path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

      const I_FULL  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>';

      const fmt = (t) => { if (!isFinite(t) || t < 0) t = 0; t = Math.floor(t); const m = Math.floor(t / 60), s = t % 60; return m + ':' + String(s).padStart(2, '0'); };



      function buildAudioPlayer(el, audio) {

        audio.dataset.enhanced = '1'; audio.removeAttribute('controls');

        const wrap = document.createElement('div'); wrap.className = 'aplayer';

        wrap.innerHTML =

          '<button class="ap-btn ap-play" aria-label="播放/暂停">' + I_PLAY + '</button>' +

          '<span class="ap-time">0:00 / 0:00</span>' +

          '<input class="ap-seek" type="range" min="0" max="1000" value="0">' +

          '<button class="ap-btn ap-vol" aria-label="静音">' + I_VOL + '</button>';

        el.appendChild(wrap); wrap.insertBefore(audio, wrap.firstChild);

        const play = wrap.querySelector('.ap-play'), time = wrap.querySelector('.ap-time'),

              seek = wrap.querySelector('.ap-seek'), vol = wrap.querySelector('.ap-vol');

        const fill = () => { const p = seek.value / 10; seek.style.background = 'linear-gradient(90deg, var(--teal) ' + p + '%, #e2e0da ' + p + '%)'; };

        play.onclick = () => audio.paused ? audio.play() : audio.pause();

        audio.onplay = () => play.innerHTML = I_PAUSE;

        audio.onpause = () => play.innerHTML = I_PLAY;

        audio.onloadedmetadata = () => time.textContent = '0:00 / ' + fmt(audio.duration);

        audio.ontimeupdate = () => { if (audio.duration) { seek.value = (audio.currentTime / audio.duration) * 1000; fill(); } time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration); };

        seek.oninput = () => { if (audio.duration) { audio.currentTime = (seek.value / 1000) * audio.duration; fill(); } };

        vol.onclick = () => { audio.muted = !audio.muted; vol.innerHTML = audio.muted ? I_MUTE : I_VOL; };

        fill();

      }



      function buildVideoPlayer(el, video) {

        video.dataset.enhanced = '1'; video.removeAttribute('controls'); video.setAttribute('playsinline', ''); video.setAttribute('webkit-playsinline', '');

        const wrap = document.createElement('div'); wrap.className = 'vplayer paused';

        el.appendChild(wrap); wrap.appendChild(video);

        const center = document.createElement('div'); center.className = 'vp-center';

        center.innerHTML = '<div class="vp-bigplay">' + I_PLAY + '</div>';

        const bar = document.createElement('div'); bar.className = 'vp-bar';

        bar.innerHTML =

          '<button class="vp-btn vp-play" aria-label="播放/暂停">' + I_PLAY + '</button>' +

          '<span class="vp-time">0:00 / 0:00</span>' +

          '<input class="vp-seek" type="range" min="0" max="1000" value="0">' +

          '<button class="vp-btn vp-mute" aria-label="静音">' + I_VOL + '</button>' +

          '<button class="vp-btn vp-full" aria-label="全屏">' + I_FULL + '</button>';

        wrap.appendChild(center); wrap.appendChild(bar);

        const big = center.querySelector('.vp-bigplay'),

              play = bar.querySelector('.vp-play'), time = bar.querySelector('.vp-time'),

              seek = bar.querySelector('.vp-seek'), mute = bar.querySelector('.vp-mute'), full = bar.querySelector('.vp-full');

        const fill = () => { const p = seek.value / 10; seek.style.background = 'linear-gradient(90deg,#fff ' + p + '%, rgba(255,255,255,.3) ' + p + '%)'; };

        const toggle = () => video.paused ? video.play() : video.pause();

        center.onclick = toggle; play.onclick = toggle;

        video.onplay = () => { wrap.classList.remove('paused'); wrap.classList.add('playing'); play.innerHTML = I_PAUSE; big.innerHTML = I_PAUSE; };

        video.onpause = () => { wrap.classList.add('paused'); wrap.classList.remove('playing'); play.innerHTML = I_PLAY; big.innerHTML = I_PLAY; };

        video.onloadedmetadata = () => time.textContent = '0:00 / ' + fmt(video.duration);

        video.ontimeupdate = () => { if (video.duration) { seek.value = (video.currentTime / video.duration) * 1000; fill(); } time.textContent = fmt(video.currentTime) + ' / ' + fmt(video.duration); };

        seek.oninput = () => { if (video.duration) { video.currentTime = (seek.value / 1000) * video.duration; fill(); } };

        mute.onclick = () => { video.muted = !video.muted; mute.innerHTML = video.muted ? I_MUTE : I_VOL; };

        full.onclick = () => {

          if (document.fullscreenElement) { document.exitFullscreen(); }

          else if (wrap.requestFullscreen) { wrap.requestFullscreen(); }

          else if (video.webkitEnterFullscreen) { video.webkitEnterFullscreen(); }

        };

        fill();

      }



      function enhanceMedia(el) {

        if (!el || !el.classList.contains('type-media')) return;

        const audio = el.querySelector('audio:not([data-enhanced])');

        const video = el.querySelector('video:not([data-enhanced])');

        if (audio) buildAudioPlayer(el, audio);

        if (video) buildVideoPlayer(el, video);

      }



      /* 把第 i 页（markdown 缓存）构建成 StPageFlip 的一张软内容页 */

      function buildContentPage(i) {

        const page = document.createElement('div');

        page.className = 'page';

        page.setAttribute('data-density', 'soft');

        const content = document.createElement('div');

        content.className = 'page-content';

        setPage(content, i);              // 复用原逻辑：填充 HTML + 打 type-* class

        page.appendChild(content);

        return page;

      }



      /* 构建硬壳封面 / 封底 */

      function buildCoverPage(opts) {

        const page = document.createElement('div');

        page.className = 'page';

        page.setAttribute('data-density', 'hard');

        const content = document.createElement('div');

        content.className = 'page-content is-cover';

        const art = document.createElement('div');

        art.className = 'cover-art' + (opts.back ? ' cover-back' : '');

        art.style.setProperty('--cover-c', opts.color || '#2f4858');

        if (opts.image && !opts.back) {

          art.classList.add('has-image');

          art.style.backgroundImage = 'url("' + opts.image + '")';

        }

        const t = document.createElement('span');

        t.className = 'cover-title';

        t.textContent = opts.back ? (opts.title ? opts.title + ' · 完' : '完') : (opts.title || '');

        art.appendChild(t);

        content.appendChild(art);

        page.appendChild(content);

        return page;

      }



      function destroyFlip() {

        if (pageFlip) { try { pageFlip.destroy(); } catch (e) {} pageFlip = null; }

        // 注意：StPageFlip 的 destroy() 会把 #flipbook 节点从 DOM 删除，

        // 所以这里始终重新拿/重建一个干净的容器，保证下次打开能正常渲染。

        let fb = document.getElementById('flipbook');

        if (!fb) {

          fb = document.createElement('div');

          fb.id = 'flipbook';

          fb.className = 'flipbook';

          windEl.appendChild(fb);

        } else {

          fb.innerHTML = '';

          fb.removeAttribute('style');

        }

        flipRoot = fb;

      }



      /* 点书脊 → 构建该书的 StPageFlip 并展示封面（效果同 Ten 页） */

      books.forEach((b) => b.addEventListener('click', () => openBook(b)));



      function buildPages(b) {

        const pages = [];

        pages.push(buildCoverPage({ title: b.dataset.name, image: b.dataset.cover, color: b.dataset.color }));

        for (let i = 0; i < total; i++) pages.push(buildContentPage(i));

        // showCover 模式下内容页为奇数时补一张空白，让封底单独成页

        if (total % 2 === 1) {

          const blank = document.createElement('div');

          blank.className = 'page'; blank.setAttribute('data-density', 'soft');

          blank.innerHTML = '<div class="page-content"></div>';

          pages.push(blank);

        }

        pages.push(buildCoverPage({ title: b.dataset.name, color: b.dataset.color, back: true }));

        pages.forEach((p) => flipRoot.appendChild(p));

      }



      function mountFlip() {

        const stage = flipRoot.closest('.flip-stage') || flipRoot.parentElement;

        const availH = (stage.clientHeight || 600) - 6;

        const availW = (stage.clientWidth || 360) - 6;

        const PAGE_W = 1200, PAGE_H = 1600;       // 页面原始尺寸（无边距）

        const PAGE_RATIO = PAGE_H / PAGE_W;       // 高/宽 = 4:3

        const landscape = !isMobile();            // 桌面双页对开 / 手机单页



        // 在可用区域内求“尽可能大”的书本（高度优先，过宽则改用宽度反推）

        let pageH = availH;

        let pageW = pageH / PAGE_RATIO;

        let bookW = landscape ? pageW * 2 : pageW;

        if (bookW > availW) {

          bookW = availW;

          pageW = landscape ? bookW / 2 : bookW;

          pageH = pageW * PAGE_RATIO;

        }

        // 不超过原图 1200×1600，避免放大模糊（始终 3:4）

        if (pageW > PAGE_W) { pageW = PAGE_W; pageH = PAGE_H; }

        pageW = Math.round(pageW); pageH = Math.round(pageH);

        bookW = landscape ? pageW * 2 : pageW;



        // 关键：给 #flipbook 显式 width + height（StPageFlip 用 offsetWidth/Height 计算页面尺寸）。

        // 配合 autoSize:false，打断“width:100% ↔ 父级收缩”的循环依赖，否则书会塌缩到最小尺寸。

        flipRoot.style.width = bookW + 'px';

        flipRoot.style.height = pageH + 'px';



        pageFlip = new PageFlip(flipRoot, {

          width: PAGE_W,

          height: PAGE_H,

          size: 'stretch',

          // 手机：让 2*minWidth > 书宽，强制竖屏单页；桌面：小 minWidth，双页对开

          minWidth: landscape ? 200 : pageW + 1,

          maxWidth: PAGE_W,

          minHeight: 280,

          maxHeight: PAGE_H,

          maxShadowOpacity: 0.5,

          showCover: true,      // 封面/封底单独成页居中

          usePortrait: true,    // 窄屏单页 / 宽屏对开

          drawShadow: true,

          flippingTime: 800,

          autoSize: false,

          mobileScrollSupport: false,

        });

        pageFlip.loadFromHTML(flipRoot.querySelectorAll('.page'));



        // 媒体页一次性增强（enhanceMedia 内部已去重）

        flipRoot.querySelectorAll('.page-content.type-media').forEach((el) => enhanceMedia(el));



        pageFlip.on('flip', (e) => updateCounter(e.data));

        pageFlip.on('changeOrientation', () => updateCounter(pageFlip.getCurrentPageIndex()));

        // 翻页时暂停晃动，静止(read)时恢复，让卷曲动画干净

        pageFlip.on('changeState', (e) => {

          if (windEl) windEl.classList.toggle('is-flipping', e.data !== 'read');

        });

        updateCounter(0);

      }



      function openBook(b) {

        activeBook = b; b.classList.add('pulling');

        activeId = parseInt(b.dataset.bookId, 10);

        total = parseInt(b.dataset.pages, 10) || 1;

        totEl.textContent = total;



        destroyFlip();

        reader.classList.add('show');

        reader.setAttribute('aria-hidden', 'false');

        // 等 reader 显示后再量取舞台尺寸；若此帧尺寸为 0 再延一帧

        requestAnimationFrame(() => {

          const stage = flipRoot.closest('.flip-stage');

          const ready = stage && stage.clientHeight > 0 && stage.clientWidth > 0;

          const go = () => { try { buildPages(b); mountFlip(); } catch (err) { console.error('[woaidan] 打开失败：', b.dataset.name, err); } };

          ready ? go() : requestAnimationFrame(go);

        });

      }



      function updateCounter(index) {

        if (!pageFlip) return;

        const last = pageFlip.getPageCount() - 1;

        if (index <= 0) { curEl.textContent = '封面'; return; }

        if (index >= last) { curEl.textContent = '封底'; return; }

        const landscape = !isMobile();

        const a = Math.min(index, total);

        const b = landscape && index + 1 <= total ? index + 1 : null;

        curEl.textContent = (b && b !== a) ? (a + '-' + b) : String(a);

      }



      function closeReader() {

        reader.classList.remove('show');

        reader.setAttribute('aria-hidden', 'true');

        if (activeBook) { activeBook.classList.remove('pulling'); activeBook = null; }

        destroyFlip();

      }



      document.getElementById('close-reader').addEventListener('click', closeReader);



      /* 键盘：Esc 关闭，左右翻页（拖动/点击由 StPageFlip 处理） */

      document.addEventListener('keydown', (e) => {

        if (!reader.classList.contains('show')) return;

        if (e.key === 'Escape') closeReader();

        else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { if (pageFlip) pageFlip.flipNext(); }

        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { if (pageFlip) pageFlip.flipPrev(); }

      });



      /* 窗口尺寸/方向变化：重建当前书的翻页器（保留所在页） */

      let rzTimer = null;

      window.addEventListener('resize', () => {

        if (!reader.classList.contains('show') || !activeBook) return;

        clearTimeout(rzTimer);

        rzTimer = setTimeout(() => {

          const cur = pageFlip ? pageFlip.getCurrentPageIndex() : 0;

          destroyFlip();

          buildPages(activeBook);

          mountFlip();

          if (pageFlip && cur > 0) { try { pageFlip.turnToPage(cur); } catch (e) {} }

        }, 220);

      });

    </script>

  )}

</body>

</html>