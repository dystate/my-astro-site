document.addEventListener('DOMContentLoaded', () => {
  const navEl    = document.getElementById('pointer-nav');
  const canvas   = document.getElementById('pointer-canvas');
  const ctx      = canvas.getContext('2d');
  const allPages = document.querySelectorAll('main[id^="page-"]');
  const items    = document.querySelectorAll('.dial-item');

  // ── 布局参数 ──────────────────────────────────────────────
  // 圆心在页面底边以下，距底边 originBelow（px）
  // 弧半径 R：菜单文字落在此圆弧上
  const ORIGIN_BELOW = 40;   // 圆心低于底边多少 px
  const R_RATIO      = 0.26; // 弧半径 = 页面宽度 * ratio

  let W, H, originX, originY, R;
  let currentAngle = null;
  let targetAngle  = null;
  let activeId     = 'about';
  let locked       = false; // 点击后锁定，不再自动跟鼠标换页

  // 角度定义：以 originX/Y 为圆心，向右为 0°，向上为 -90°
  // 菜单项角度（度 → 弧度）
  const ITEMS = [
    { id: 'about',   angleDeg: -160 },
    { id: 'photo',   angleDeg: -123 },
    { id: 'home',    angleDeg: -68  },
    { id: 'books',   angleDeg: -30  },
    { id: 'archive', angleDeg: -8   },
  ];

  function degToRad(d) { return d * Math.PI / 180; }

  function resize() {
    // canvas 尺寸
    W = navEl.offsetWidth;
    H = navEl.offsetHeight;
    canvas.width  = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(1,0,0,1,0,0);
    ctx.scale(devicePixelRatio, devicePixelRatio);

    // 圆心位置（在 nav 元素的坐标系内）
    originX = W * 0.48;
    originY = H + ORIGIN_BELOW;
    R = W * R_RATIO;

    // 布局所有菜单项
    ITEMS.forEach(cfg => {
      const el  = document.getElementById('nav-' + cfg.id);
      if (!el) return;
      const rad = degToRad(cfg.angleDeg);
      const ix  = originX + Math.cos(rad) * R;
      const iy  = originY + Math.sin(rad) * R;
      el.style.left = ix + 'px';
      el.style.top  = iy + 'px';
    });

    // 初始指针角度朝向 about
    if (currentAngle === null) {
      const a = degToRad(ITEMS.find(i => i.id === 'about').angleDeg);
      currentAngle = a;
      targetAngle  = a;
    }
  }

  // ── 平滑插值角度 ──────────────────────────────────────────
  function lerpAngle(a, b, t) {
    let d = b - a;
    while (d >  Math.PI) d -= 2 * Math.PI;
    while (d < -Math.PI) d += 2 * Math.PI;
    return a + d * t;
  }

  // ── 页面切换 ──────────────────────────────────────────────
  function switchPage(id) {
    if (id === activeId) return;
    activeId = id;
    allPages.forEach(p => {
      const on = p.id === 'page-' + id;
      p.classList.toggle('opacity-100',         on);
      p.classList.toggle('pointer-events-auto', on);
      p.classList.toggle('scale-100',           on);
      p.classList.toggle('opacity-0',          !on);
      p.classList.toggle('pointer-events-none',!on);
      p.classList.toggle('scale-[0.98]',       !on);
    });
    items.forEach(el => el.classList.toggle('active', el.dataset.id === id));
  }

  // ── 绘制指针 ──────────────────────────────────────────────
  function draw() {
    ctx.clearRect(0, 0, W, H);

    // 主针：从圆心出发，长度约 R * 1.05（稍微超过弧线）
    const lenMain = R * 1.02;
    // 副针：约 R * 0.45，偏转约 8° (原版的小叉角)
    const lenSub  = R * 0.44;
    const subOff  = degToRad(8);

    const ex1 = originX + Math.cos(currentAngle) * lenMain;
    const ey1 = originY + Math.sin(currentAngle) * lenMain;
    const ex2 = originX + Math.cos(currentAngle + subOff) * lenSub;
    const ey2 = originY + Math.sin(currentAngle + subOff) * lenSub;

    ctx.lineCap = 'round';

    // 主针
    ctx.beginPath();
    ctx.moveTo(originX, originY);
    ctx.lineTo(ex1, ey1);
    ctx.strokeStyle = 'rgba(22,22,20,0.78)';
    ctx.lineWidth   = 0.9;
    ctx.stroke();

    // 副针（半透明细线）
    ctx.beginPath();
    ctx.moveTo(originX, originY);
    ctx.lineTo(ex2, ey2);
    ctx.strokeStyle = 'rgba(22,22,20,0.30)';
    ctx.lineWidth   = 0.7;
    ctx.stroke();

    // 圆心小点
    ctx.beginPath();
    ctx.arc(originX, originY, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(22,22,20,0.82)';
    ctx.fill();
  }

  // ── 主循环 ────────────────────────────────────────────────
  function tick() {
    currentAngle = lerpAngle(currentAngle, targetAngle, 0.09);
    draw();
    requestAnimationFrame(tick);
  }

  // ── 事件：鼠标移动只转指针 ───────────────────────────────
  document.addEventListener('mousemove', e => {
    const rect = navEl.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    targetAngle = Math.atan2(my - originY, mx - originX);
  });

  // ── 事件：点击菜单项才切换页面 ──────────────────────────
  items.forEach(el => {
    el.addEventListener('click', () => {
      const id  = el.dataset.id;
      const cfg = ITEMS.find(i => i.id === id);
      if (cfg) targetAngle = degToRad(cfg.angleDeg);
      switchPage(id);
    });
  });

  // ── 事件：鼠标离开窗口，指针归位 ────────────────────────
  document.addEventListener('mouseleave', () => {
    const cfg = ITEMS.find(i => i.id === activeId);
    if (cfg) targetAngle = degToRad(cfg.angleDeg);
  });

  // ── 初始化 ────────────────────────────────────────────────
  resize();
  window.addEventListener('resize', resize);
  switchPage('about');
  // 手动触发初始 active class
  items.forEach(el => el.classList.toggle('active', el.dataset.id === 'about'));
  tick();
});
</script>
