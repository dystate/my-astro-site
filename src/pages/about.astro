---
// src/pages/about.astro (35° 紧凑齿轮 + 移动端自适应版)
import "@/styles/global.css";

const pageData = [
  {
    id: "home",
    title: "Entering the<br class='hidden lg:block'/>Digital Nexus.<br/>System Online.",
    subtitle: "Welcome to the terminal.",
    desc: "这是数字世界的主控台。将凌乱的思绪重组，在 0 与 1 的间隙中，构建秩序与美学并存的个人栖息地。",
    img: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1287&auto=format&fit=crop"
  },
  {
    id: "photo",
    title: "Visualizing<br class='hidden lg:block'/>Micro & Macro<br/>Structures.",
    subtitle: "1:1 Aspect Ratio.",
    desc: "从宏观的建筑几何，到微观的材料纹理。用图像捕捉转瞬即逝的光影，定格每一次观察的截面。",
    img: "https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=1287&auto=format&fit=crop"
  },
  {
    id: "about",
    title: "Dystate is the name, the Undergraduate & Explorer of Digital Space.<br/>Relocating to Future.",
    subtitle: "Relocating to Future.",
    desc: "致力于在平面的屏幕中寻找立体的呼吸感。探索电化学与审美逻辑的交叉点，为每一次日志提供独特的体验。",
    img: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1287&auto=format&fit=crop"
  },
  {
    id: "archive",
    title: "The Markdown<br class='hidden lg:block'/>Repository &<br/>Knowledge Graph.",
    subtitle: "Timeline Log.",
    desc: "一个结构化的数字日记系统。记录 CSS 渲染的实验、文献阅读的切片，以及时间轴上每一处闪光的节点。",
    img: "https://images.unsplash.com/photo-1555949963-aa79dcee981c?q=80&w=1287&auto=format&fit=crop"
  },
  {
    id: "books",
    title: "Accumulation of<br class='hidden lg:block'/>Theoretical<br/>Foundations.",
    subtitle: "Read & Think.",
    desc: "智慧的摄入与消化。通过阅读构建底层逻辑，在字里行间跨越科学与艺术的边界。",
    img: "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?q=80&w=1287&auto=format&fit=crop"
  }
];

// 【核心修改】：35° 完美等分阵列。覆盖更密集的圆周，保证视野内紧凑无留白。
const dialItems = [
  { angle: -175, target: "about", label: "About" },
  { angle: -140, target: "photo", label: "Photo" },
  { angle: -105, target: "home", label: "Home" },
  { angle: -70, target: "books", label: "Books" },
  { angle: -35, target: "archive", label: "Archive" },
  { angle: 0, target: "about", label: "About" },
  { angle: 35, target: "photo", label: "Photo" },
  { angle: 70, target: "home", label: "Home" },
  { angle: 105, target: "books", label: "Books" },
  { angle: 140, target: "archive", label: "Archive" },
  { angle: 175, target: "about", label: "About" }
];
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Dystate - Interactive Terminal</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-[#f4f4f0] text-[#1a1a1a] font-['Inter'] antialiased h-screen w-full overflow-hidden relative selection:bg-black selection:text-white">
    
    <div class="absolute top-6 left-4 lg:top-10 lg:left-10 -rotate-12 origin-top-left z-20 pointer-events-none">
      <p class="font-['Inter'] text-[8px] lg:text-[10px] tracking-[0.3em] uppercase leading-tight text-black/40 font-semibold">
        Archives // 2026<br/>Dystate Project
      </p>
    </div>

    <div class="absolute top-6 lg:top-8 left-1/2 -translate-x-1/2 z-20">
      <div class="flex flex-col items-center">
        <span class="font-['Playfair_Display'] text-3xl lg:text-4xl italic leading-none text-black">Dy</span>
        <span class="text-[8px] lg:text-[9px] font-['Inter'] tracking-[0.4em] uppercase mt-1 font-semibold text-black">STATE</span>
      </div>
    </div>

    <div class="absolute top-6 right-4 lg:top-10 lg:right-10 z-20 text-right flex flex-col gap-[2px] text-[8px] lg:text-[10px] tracking-[0.2em] uppercase font-semibold text-black/60">
      <a href="#" class="hover:text-black transition-colors">Email</a>
      <a href="#" class="hover:text-black transition-colors">Twitter</a>
      <a href="#" class="hover:text-black transition-colors">Github</a>
      <a href="#" class="hover:text-black transition-colors">Obsidian</a>
    </div>

    <div id="stage-container" class="w-full h-full relative z-10 px-6 lg:px-12 pt-24 lg:pt-32 pb-[160px]">
      {pageData.map((page) => (
        <main 
          id={"page-" + page.id} 
          class={"absolute inset-0 px-6 lg:px-12 pt-24 lg:pt-32 pb-[160px] flex flex-col lg:flex-row justify-start lg:justify-between items-center lg:items-stretch transition-all duration-[800ms] ease-[cubic-bezier(0.25,1,0.3,1)] overflow-y-auto lg:overflow-visible " + (page.id === 'about' ? 'opacity-100 pointer-events-auto scale-100' : 'opacity-0 pointer-events-none scale-[0.98]')}
        >
          
          <div class="w-[50%] sm:w-[40%] lg:w-[35%] h-[32vh] lg:h-[65vh] mt-2 lg:mt-4 shadow-2xl overflow-hidden order-1 lg:order-2 shrink-0">
            <img 
              src={page.img} 
              alt="Editorial" 
              class="w-full h-full object-cover grayscale contrast-[1.05]"
            />
          </div>

          <div class="w-full lg:w-[55%] h-auto lg:h-full flex flex-col justify-start lg:justify-between relative order-2 lg:order-1 mt-4 lg:mt-0 min-h-0 overflow-y-auto lg:overflow-visible">
            
            <div class="max-w-full lg:max-w-[40rem] mt-1 lg:mt-6 text-center lg:text-left">
              <h1 class="font-['Playfair_Display'] text-[1.6rem] sm:text-[2rem] lg:text-[3rem] xl:text-[3.6rem] leading-[1.15] text-[#111] tracking-tight font-normal" set:html={page.title}>
              </h1>
            </div>

            <div class="flex flex-col lg:flex-row items-center lg:items-end gap-2 lg:gap-6 mt-3 lg:mb-4">
              <div class="hidden lg:flex w-[90px] h-[120px] bg-white shrink-0 shadow-md border border-black/10 items-center justify-center p-2 relative overflow-hidden">
                 <img src="/avatar.svg" alt="Portrait" class="w-full h-full object-cover grayscale brightness-90 border-2 border-black/10 shadow-inner" />
              </div>
              <div class="pb-1 text-center lg:text-left">
                <p class="hidden lg:block text-[10px] uppercase tracking-[0.2em] text-black/40 font-bold mb-1">{page.subtitle}</p>
                <p class="w-full max-w-[90%] lg:max-w-[260px] mx-auto lg:mx-0 text-[11px] lg:text-[12px] leading-[1.6] text-black/70 font-medium">
                  {page.desc}
                </p>
              </div>
            </div>

          </div>

        </main>
      ))}
    </div>

    <div class="absolute bottom-4 lg:bottom-8 left-4 lg:left-10 text-[7px] lg:text-[9px] tracking-[0.2em] uppercase text-black/40 z-20 font-semibold">
      © All rights reserved. 2026
    </div>
    <div class="absolute bottom-4 lg:bottom-8 right-4 lg:right-10 text-[7px] lg:text-[9px] tracking-[0.2em] uppercase text-black/40 z-20 font-semibold">
      Site by Dystate
    </div>


    <div class="fixed bottom-0 left-0 w-full h-[140px] lg:h-[250px] overflow-hidden pointer-events-none z-[100]">
        
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[200px] h-[100px] z-10">
            <svg viewBox="0 0 200 100" class="w-full h-full overflow-visible">
                <circle cx="100" cy="100" r="4" fill="#111" />
                <line x1="100" y1="100" x2="100" y2="40" stroke="#111" stroke-width="2.4" />
                <line x1="100" y1="100" x2="75" y2="70" stroke="#111" stroke-width="1.2" opacity="0.3" />
                <line x1="100" y1="100" x2="125" y2="70" stroke="#111" stroke-width="1.2" opacity="0.3" />
            </svg>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 translate-y-1/2 w-[700px] h-[700px] bottom-[-230px] lg:w-[440px] lg:h-[440px] lg:bottom-0">
            <div id="dial-wheel" class="relative w-full h-full transition-transform duration-[1000ms] cubic-bezier(0.22, 1, 0.36, 1)">
                
                {dialItems.map((item) => (
                    <div 
                      class={"dial-word " + (item.target === 'about' && item.angle === 0 ? 'active' : '')} 
                      style={"transform: rotate(" + item.angle + "deg);"} 
                      data-angle={item.angle} 
                      data-target={item.target}
                    >
                        <div class="cursor-pointer"><span>{item.label}</span></div>
                    </div>
                ))}

            </div>
        </div>

    </div>

  </body>
</html>

<style is:global>
  ::-webkit-scrollbar { display: none; }

  /* ---------------------------------
     手机端: 巨型平盘 + 更密集的 35°
     --------------------------------- */
  .dial-word {
    position: absolute;
    left: 50%;
    top: 20px; 
    transform-origin: 50% 330px; /* 330px 超大半径维持黄线平缓感 */
    font-size: 11px; 
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-weight: 600;
    width: 120px;
    text-align: center;
    margin-left: -60px;
    user-select: none;
    pointer-events: auto;
  }

  .dial-word span {
    display: inline-block;
    transition: transform 1000ms cubic-bezier(0.22, 1, 0.36, 1), font-size 0.4s, color 0.4s;
    color: rgba(0,0,0,0.25);
  }

  .dial-word:hover span {
    color: rgba(0,0,0,0.8);
  }

  .dial-word.active span {
    font-size: 16px; 
    font-weight: 800;
    color: #111;
  }

  /* ---------------------------------
     电脑端: 200px 半径标准盘
     --------------------------------- */
  @media (min-width: 1024px) {
    .dial-word {
      transform-origin: 50% 200px;
      font-size: 13px;
      width: 140px;
      margin-left: -70px;
    }
    .dial-word.active span {
      font-size: 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wheel = document.getElementById('dial-wheel');
    const items = document.querySelectorAll('.dial-word');
    const spans = document.querySelectorAll('.dial-word span');
    const allPages = document.querySelectorAll('main[id^="page-"]');

    function initTypography() {
        items.forEach(item => {
            const angle = parseFloat(item.getAttribute('data-angle'));
            const span = item.querySelector('span');
            span.style.transform = `rotate(${-angle}deg)`;
        });
    }

    initTypography();

    items.forEach(item => {
        item.addEventListener('click', () => {
            const targetAngle = parseFloat(item.getAttribute('data-angle'));
            const targetPageId = item.getAttribute('data-target');

            wheel.style.transform = `rotate(${-targetAngle}deg)`;

            spans.forEach((span, index) => {
                const originalWordAngle = parseFloat(items[index].getAttribute('data-angle'));
                span.style.transform = `rotate(${targetAngle - originalWordAngle}deg)`;
            });

            items.forEach(i => i.classList.remove('active'));
            item.classList.add('active');

            allPages.forEach(page => {
                if(page.id === `page-${targetPageId}`) {
                    page.classList.remove('opacity-0', 'pointer-events-none', 'scale-[0.98]');
                    page.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
                } else {
                    page.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
                    page.classList.add('opacity-0', 'pointer-events-none', 'scale-[0.98]');
                }
            });
        });
    });
  });
</script>
