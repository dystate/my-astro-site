  document.addEventListener('DOMContentLoaded', () => {
    const wheel = document.getElementById('dial-wheel');
    const items = document.querySelectorAll('.dial-word');
    const spans = document.querySelectorAll('.dial-word span');
    const allPages = document.querySelectorAll('main[id^="page-"]');

    function initTypography() {
        items.forEach(item => {
            const angle = parseFloat(item.getAttribute('data-angle'));
            const span = item.querySelector('span');
            span.style.transform = `rotate(${-angle}deg)`;
        });
    }

    initTypography();

    items.forEach(item => {
        item.addEventListener('click', () => {
            const targetAngle = parseFloat(item.getAttribute('data-angle'));
            const targetPageId = item.getAttribute('data-target');

            wheel.style.transform = `rotate(${-targetAngle}deg)`;

            spans.forEach((span, index) => {
                const originalWordAngle = parseFloat(items[index].getAttribute('data-angle'));
                span.style.transform = `rotate(${targetAngle - originalWordAngle}deg)`;
            });

            items.forEach(i => i.classList.remove('active'));
            item.classList.add('active');

