---
// src/pages/logs/[...slug].astro
// 单篇日志文章页 —— 匹配 LogsShowcase 中 /logs/{slug} 的链接
import "@/styles/global.css";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../lib/logs";
import { getPublishedRemoteLog } from "../../lib/remoteLogs";
import { marked } from "marked";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/logs");

// 1️⃣ 优先用 getEntry() 查找（有 render() 方法）
let remoteEntry = await getPublishedRemoteLog(slug!);
let entry = remoteEntry ? null : await getEntry("logs", slug!);

// 2️⃣ Fallback：dev server 重命名文件后缓存可能滞后，用 getCollection 兜底
if (!remoteEntry && (!entry || !("render" in entry))) {
  const all = await getCollection("logs", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  entry = all.find((e) => e.id === slug) as typeof entry;
}

if (!remoteEntry && (!entry || !("render" in entry))) return Astro.redirect("/404");

// 生产环境隐藏草稿
if (!remoteEntry && import.meta.env.PROD && entry!.data.draft) return Astro.redirect("/404");

const rendered = remoteEntry ? null : await render(entry as any);
const Content = rendered?.Content;
const { title, date } = remoteEntry?.data ?? entry!.data;
const remoteHtml = remoteEntry ? await marked.parse(remoteEntry.body) : "";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Dystate</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Open+Sans:wght@800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="article-body">
    <!-- 返回按钮 -->
    <a href="/logs" class="back-btn" title="返回日志列表">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span>LOGS</span>
    </a>

    <main class="article-main">
      <article class="article-card">
        <header class="article-header">
          <span class="article-date">{formatDate(date)}</span>
          <h1 class="article-title">{title}</h1>
        </header>
        <div class="article-content">
          {remoteEntry ? <Fragment set:html={remoteHtml} /> : Content && <Content />}
        </div>
      </article>
    </main>
  </body>
</html>

<style is:global>
  .article-body {
    margin: 0;
    min-height: 100dvh;
    background: #050505;
    color: #fff;
    font-family: "Instrument Serif", Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }

  /* 返回按钮 */
  .back-btn {
    position: fixed;
    top: clamp(16px, 3vw, 28px);
    left: clamp(12px, 3vw, 28px);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    text-decoration: none;
    font: 800 13px/1 "Open Sans", sans-serif;
    letter-spacing: 0.06em;
    padding: 8px 14px 8px 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.2s, border-color 0.2s;
  }
  .back-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
  }
  .back-btn svg {
    flex-shrink: 0;
  }

  /* 主体 */
  .article-main {
    display: flex;
    justify-content: center;
    padding: clamp(80px, 12vh, 120px) clamp(16px, 5vw, 64px) 10vh;
    min-height: 100dvh;
    box-sizing: border-box;
  }

  .article-card {
    width: 100%;
    max-width: 720px;
  }

  /* 文章头部 */
  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .article-date {
    font: 400 13px/1 "Nokia Cellphone FC Small", ui-monospace, monospace;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.42);
  }
  .article-title {
    font: 400 clamp(30px, 4.5vw, 52px) / 1.12 "Instrument Serif", serif;
    color: #fff;
    margin: 0.35em 0 0;
  }

  /* 文章正文 —— 匹配 logs 页面的色调体系 */
  .article-content {
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.75;
  }
  .article-content h1,
  .article-content h2,
  .article-content h3 {
    font-family: "Open Sans", sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
    margin-top: 2.2em;
    margin-bottom: 0.5em;
  }
  .article-content h2 {
    font-size: clamp(22px, 2.6vw, 30px);
  }
  .article-content h3 {
    font-size: clamp(18px, 2vw, 24px);
  }
  .article-content p {
    margin: 0 0 1.1em;
  }
  .article-content a {
    color: #5451f2;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .article-content a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
  .article-content code {
    font-family: "Nokia Cellphone FC Small", ui-monospace, monospace;
    font-size: 0.82em;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .article-content pre {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    font-size: 0.9em;
    line-height: 1.6;
  }
  .article-content pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .article-content img {
    border-radius: 10px;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.6rem auto;
  }
  .article-content blockquote {
    border-left: 3px solid #5451f2;
    padding-left: 1.1rem;
    margin: 1.5em 0;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
  }
  .article-content strong {
    color: #fff;
  }
  .article-content ul,
  .article-content ol {
    padding-left: 1.4em;
  }
  .article-content li {
    margin-bottom: 0.35em;
  }
  .article-content hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5em 0;
  }

  /* 移动端安全带 */
  @media (max-width: 640px) {
    .article-title {
      font-size: clamp(26px, 7vw, 36px);
    }
    .article-content {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-btn {
      transition: none;
    }
  }
</style>
