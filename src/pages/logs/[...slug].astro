---
// src/pages/logs/[...slug].astro
// 单篇日志文章页 —— 匹配 LogsShowcase 中 /logs/{slug} 的链接
import "@/styles/global.css";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../lib/logs";
import { getRemoteLogState } from "../../lib/remoteLogs";
import { renderRemoteLogMarkdown } from "../../lib/remoteLogMarkdown";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/logs");

// 1️⃣ 优先用 getEntry() 查找（有 render() 方法）
const remoteState = await getRemoteLogState();
if (remoteState.hiddenIds.has(slug!)) return Astro.redirect("/404");
let remoteEntry = remoteState.entries.find((entry) => entry.id === slug!) || null;
let entry = remoteEntry ? null : await getEntry("logs", slug!);

// 2️⃣ Fallback：dev server 重命名文件后缓存可能滞后，用 getCollection 兜底
if (!remoteEntry && (!entry || !("render" in entry))) {
  const all = await getCollection("logs", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  entry = all.find((e) => e.id === slug) as typeof entry;
}

if (!remoteEntry && (!entry || !("render" in entry))) return Astro.redirect("/404");

// 生产环境隐藏草稿
if (!remoteEntry && import.meta.env.PROD && entry!.data.draft) return Astro.redirect("/404");

const rendered = remoteEntry ? null : await render(entry as any);
const Content = rendered?.Content;
const { title, date } = remoteEntry?.data ?? entry!.data;
const remoteHtml = remoteEntry ? await renderRemoteLogMarkdown(remoteEntry.body) : "";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Dystate</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Open+Sans:wght@800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="article-body">
    <!-- 返回按钮 -->
    <a href="/logs" class="back-btn" title="返回日志列表">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span>LOGS</span>
    </a>

    <main class="article-main">
      <article class="article-card">
        <header class="article-header">
          <span class="article-date">{formatDate(date)}</span>
          <h1 class="article-title">{title}</h1>
        </header>
        <div class="article-content">
          {remoteEntry ? <Fragment set:html={remoteHtml} /> : Content && <Content />}
        </div>
      </article>
    </main>
  </body>
</html>

<style is:global>
  .article-body {
    margin: 0;
    min-height: 100dvh;
    background: #050505;
    color: #fff;
    font-family: "Instrument Serif", Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }

  /* 返回按钮 */
  .back-btn {
    position: fixed;
    top: clamp(16px, 3vw, 28px);
    left: clamp(12px, 3vw, 28px);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    text-decoration: none;
    font: 800 13px/1 "Open Sans", sans-serif;
    letter-spacing: 0.06em;
    padding: 8px 14px 8px 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.2s, border-color 0.2s;
  }
  .back-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
  }
  .back-btn svg {
    flex-shrink: 0;
  }

  /* 主体 */
  .article-main {
    display: flex;
    justify-content: center;
    padding: clamp(80px, 12vh, 120px) clamp(16px, 5vw, 64px) 10vh;
    min-height: 100dvh;
    box-sizing: border-box;
  }

  .article-card {
    width: 100%;
    max-width: 720px;
  }

  /* 文章头部 */
  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .article-date {
    font: 400 13px/1 "Nokia Cellphone FC Small", ui-monospace, monospace;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.42);
  }
  .article-title {
    font: 400 clamp(30px, 4.5vw, 52px) / 1.12 "Instrument Serif", serif;
    color: #fff;
    margin: 0.35em 0 0;
  }

  /* 文章正文 —— 匹配 logs 页面的色调体系 */
  .article-content {
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.75;
  }
  .article-content h1,
  .article-content h2,
  .article-content h3 {
    font-family: "Open Sans", sans-serif;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
    margin-top: 2.2em;
    margin-bottom: 0.5em;
  }
  .article-content h2 {
    font-size: clamp(22px, 2.6vw, 30px);
  }
  .article-content h3 {
    font-size: clamp(18px, 2vw, 24px);
  }
  .article-content p {
    margin: 0 0 1.1em;
  }
  .article-content a {
    color: #5451f2;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .article-content a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
  .article-content code {
    font-family: "Nokia Cellphone FC Small", ui-monospace, monospace;
    font-size: 0.82em;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .article-content pre {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    font-size: 0.9em;
    line-height: 1.6;
  }
  .article-content pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .article-content img {
    border-radius: 10px;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.6rem auto;
  }
  .article-content blockquote {
    border-left: 3px solid #5451f2;
    padding-left: 1.1rem;
    margin: 1.5em 0;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
  }
  .article-content strong {
    color: #fff;
  }
  .article-content ul,
  .article-content ol {
    padding-left: 1.4em;
  }
  .article-content li {
    margin-bottom: 0.35em;
  }
  .article-content hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5em 0;
  }

  /* Supabase journals use the same PhotoStack geometry as local MDX logs. */
  .remote-photo-stack { position: relative; margin: .25rem 0; }
  .rps-toolbar {
    position: sticky; top: clamp(64px, 9vh, 84px); z-index: 6;
    display: flex; justify-content: flex-end; padding-bottom: 8px;
    pointer-events: none;
  }
  .rps-toggle {
    pointer-events: auto; cursor: pointer; color: #fff;
    font: 800 12px/1 "Open Sans", sans-serif; letter-spacing: .06em;
    padding: 8px 14px; border-radius: 999px;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(8px);
  }
  .rps-card-wrap {
    height: min(72vh, 500px); display: flex; align-items: flex-start;
    justify-content: center; padding: clamp(24px, 6vh, 56px) 16px 0;
    box-sizing: border-box;
  }
  .rps-card {
    position: sticky; top: calc(clamp(64px, 9vh, 84px) + var(--rps-top));
    width: min(100%, 440px); height: min(50vh, 340px);
    border-radius: 14px; overflow: hidden; transform-origin: top center;
    box-shadow: 0 22px 46px -20px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.06);
  }
  .rps-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0 !important; border-radius: 0 !important; }
  .rps-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.15) 38%, transparent 60%); }
  .rps-info { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(14px,2.2vw,22px); z-index: 2; }
  .rps-title { font: 400 clamp(22px,3vw,34px)/1.06 "Instrument Serif", Georgia, serif; color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,.45); }
  .rps-caption { margin-top: 7px; font: 400 clamp(13px,1.4vw,15px)/1.45 "Geist Variable", "Geist", system-ui, sans-serif; color: rgba(255,255,255,.84); max-width: 46ch; }
  .rps-number { position: absolute; top: clamp(16px,2.4vw,26px); right: clamp(16px,2.4vw,26px); z-index: 2; font: 700 12px/1 "Nokia Cellphone FC Small", monospace; letter-spacing: .08em; color: rgba(255,255,255,.85); }
  .remote-photo-stack.is-collapsed .rps-toolbar { position: static; margin-bottom: 8px; }
  .remote-photo-stack.is-collapsed .rps-cards { position: relative; width: min(100%, 440px); height: min(54vh, 372px); margin: 0 auto; }
  .remote-photo-stack.is-collapsed .rps-card-wrap {
    position: absolute; inset: 0; width: 100%; height: min(50vh, 340px); padding: 0;
    z-index: var(--rps-reverse); transform: translateY(var(--rps-offset)) scale(var(--rps-scale));
    transform-origin: top center;
  }
  .remote-photo-stack.is-collapsed .rps-card { position: relative; top: 0; width: 100%; height: 100%; }
  @media (max-width: 640px) {
    .rps-card { width: 86vw; height: min(56vh, 320px); border-radius: 12px; }
    .remote-photo-stack.is-collapsed .rps-cards { width: 86vw; height: min(58vh, 350px); }
    .remote-photo-stack.is-collapsed .rps-card-wrap { width: 86vw; height: min(56vh, 320px); }
  }

  /* 2号流动：图片像一叠卡片，最上层滑走后循环到底部。 */
  .remote-photo-flow {
    display: grid; place-items: center; margin: 1.5rem 0 2.8rem;
    overflow: hidden; touch-action: pan-y;
  }
  .rpf-deck {
    position: relative; width: min(78vw, 430px); aspect-ratio: 3 / 4;
    margin-right: min(10vw, 58px); outline: none; cursor: grab;
    touch-action: pan-y; user-select: none; -webkit-user-select: none;
  }
  .rpf-deck:active { cursor: grabbing; }
  .rpf-deck:focus-visible::after {
    content: ""; position: absolute; inset: -8px -58px -8px -8px;
    border: 2px solid #5451f2; pointer-events: none;
  }
  .rpf-card {
    --rpf-x: 0px; --rpf-y: 0px; --rpf-scale: 1; --rpf-rotate: 0deg; --rpf-drag-x: 0px;
    position: absolute; inset: 0; overflow: hidden; box-sizing: border-box;
    border: 0; border-radius: 14px;
    background: #111; transform-origin: center;
    transform: translate3d(calc(var(--rpf-x) + var(--rpf-drag-x)), var(--rpf-y), 0) scale(var(--rpf-scale)) rotate(var(--rpf-rotate));
    transition: transform 430ms cubic-bezier(.22,1,.36,1), opacity 280ms ease;
    will-change: transform; pointer-events: none;
  }
  .rpf-card.is-active { pointer-events: auto; }
  .rpf-card.is-dragging { transition: none; }
  .rpf-card.is-resetting { transition: none; }
  .rpf-card.is-leaving { opacity: 0; }
  .rpf-card.is-hidden { visibility: hidden; }
  .rpf-media {
    position: absolute; inset: 0; display: block; width: 100%; height: 100%;
    margin: 0 !important; border-radius: 0 !important; object-fit: cover;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .remote-photo-flow { margin-inline: calc(50% - 50vw); }
    .rpf-deck { width: min(76vw, 390px); margin-right: 11vw; }
  }

  /* 移动端安全带 */
  @media (max-width: 640px) {
    .article-title {
      font-size: clamp(26px, 7vw, 36px);
    }
    .article-content {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-btn {
      transition: none;
    }
    .rpf-card { transition: none; }
  }
</style>

<script is:inline>
  const setupPhotoFlow = (flow) => {
    const deck = flow.querySelector(".rpf-deck");
    const cards = [...flow.querySelectorAll(".rpf-card")];
    if (!(deck instanceof HTMLElement) || cards.length === 0) return;

    let activeIndex = 0;
    let pointerId = null;
    let startX = 0;
    let startY = 0;
    let dragX = 0;
    let moved = false;
    let animating = false;

    const renderDeck = () => {
      flow.dataset.flowIndex = String(activeIndex);
      cards.forEach((card, index) => {
        const depth = (index - activeIndex + cards.length) % cards.length;
        const visible = depth < Math.min(cards.length, 4);
        card.classList.toggle("is-active", depth === 0);
        card.classList.toggle("is-hidden", !visible);
        card.setAttribute("aria-hidden", String(depth !== 0));
        card.style.zIndex = String(cards.length - depth);
        card.style.setProperty("--rpf-x", `${depth * 15}px`);
        card.style.setProperty("--rpf-y", `${depth * 8}px`);
        card.style.setProperty("--rpf-scale", String(1 - depth * .022));
        card.style.setProperty("--rpf-rotate", `${depth * .55}deg`);
        if (depth !== 0) card.style.setProperty("--rpf-drag-x", "0px");
      });
    };

    const advance = (direction = -1) => {
      if (animating || cards.length < 2) return;
      animating = true;
      const leaving = cards[activeIndex];
      leaving.classList.remove("is-dragging");
      leaving.classList.add("is-leaving");
      leaving.style.setProperty("--rpf-drag-x", `${direction * (deck.clientWidth + 100)}px`);
      window.setTimeout(() => {
        activeIndex = (activeIndex + 1) % cards.length;
        leaving.classList.add("is-resetting");
        leaving.classList.remove("is-leaving");
        leaving.style.setProperty("--rpf-drag-x", "0px");
        renderDeck();
        requestAnimationFrame(() => {
          leaving.classList.remove("is-resetting");
          animating = false;
        });
      }, 300);
    };

    deck.addEventListener("pointerdown", (event) => {
      if (animating || cards.length < 2) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      dragX = 0;
      moved = false;
      deck.setPointerCapture(pointerId);
      cards[activeIndex].classList.add("is-dragging");
    });
    deck.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pointerId) return;
      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;
      if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 8) return;
      dragX = deltaX;
      moved ||= Math.abs(deltaX) > 6;
      cards[activeIndex].style.setProperty("--rpf-drag-x", `${deltaX}px`);
    });
    const finishDrag = (event) => {
      if (event.pointerId !== pointerId) return;
      const active = cards[activeIndex];
      active.classList.remove("is-dragging");
      pointerId = null;
      if (Math.abs(dragX) > Math.min(70, deck.clientWidth * .16)) {
        advance(dragX < 0 ? -1 : 1);
      } else {
        active.style.setProperty("--rpf-drag-x", "0px");
      }
    };
    deck.addEventListener("pointerup", finishDrag);
    deck.addEventListener("pointercancel", finishDrag);
    deck.addEventListener("click", () => { if (!moved) advance(-1); });
    deck.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Enter", " "].includes(event.key)) return;
      event.preventDefault();
      advance(event.key === "ArrowRight" ? 1 : -1);
    });
    renderDeck();
  };

  document.querySelectorAll(".remote-photo-flow").forEach(setupPhotoFlow);

  document.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest(".rps-toggle") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    const stack = button.closest(".remote-photo-stack");
    if (!stack) return;
    const collapsed = stack.classList.toggle("is-collapsed");
    button.setAttribute("aria-pressed", String(collapsed));
    button.textContent = collapsed ? "展开 ↓" : "收起 ↑";
  });
</script>
