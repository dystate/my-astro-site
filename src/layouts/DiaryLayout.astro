---
// src/layouts/DiaryLayout.astro
import "@/styles/global.css";
const { frontmatter } = Astro.props;

// 背景图和底色
const bgImage = frontmatter.background || ""; 
const bgColor = frontmatter.bgColor || "#ffffff"; 
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} - Dystate</title>
  </head>
  <body class="antialiased relative overflow-x-hidden min-h-screen" style={`background-color: ${bgColor};`}>
    
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="w-full h-full bg-center bg-no-repeat bg-contain" 
           style={`
             background-image: url('${bgImage}'); 
             -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); 
             mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
           `}>
      </div>
    </div>

    <button 
      onclick="history.back()" 
      class="fixed top-8 left-6 z-[100] group p-2 transition-opacity mix-blend-difference text-white hover:opacity-50"
      title="返回"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>

    <main class="relative z-10 flex justify-center min-h-screen">
      <article class="w-full max-w-4xl px-4 pt-24 pb-32">
        
        <div class="prose prose-slate prose-xl max-w-none 
          prose-p:text-slate-900 prose-p:leading-relaxed
          prose-img:m-0 prose-img:p-0 prose-img:border-none prose-img:shadow-none prose-img:rounded-none">
          <slot />
        </div>

      </article>
    </main>

    <style is:global>
      /* 彻底清除 Markdown 渲染图片的默认边距和修饰，方便你做拼贴 */
      .prose img {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 auto 20px auto !important; /* 居中并留出底部间距 */
        border-radius: 0 !important;
        display: block !important;
      }
    </style>
  </body>
</html>
